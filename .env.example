# MIDAS_LIVE=0   # global real-money gate; 0/false=off (default), 1/true=on; overrides data/agent_config/live_switch.json
# MIDAS_DATA_DIR=/path/to/root   # redirect all data reads/writes to a different root (default = repo root); used by forks and isolated test runs

# Shared secret gating the backtester Cloud Run service (SP3).
# Unset locally = gate disabled; MUST be set in production (Cloud Run + Netlify proxy).
BACKTESTER_SECRET=
