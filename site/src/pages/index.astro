---
// The front page (2026-09-18 clarity pass).
//
// The previous page said everything at once: 62 text fragments above the fold
// at 1280×900, the roster size three times, the timestamp three times, and a
// first screen that was a returns instrument — leader, worst, spread, a
// nine-column board — which is the one claim this project's own methodology
// says it must not lead with. The promise that LinkedIn's preview showed (the
// meta description: every order and refusal public, paper money, controls)
// vanished once the visitor landed, and the page had no link to /arena,
// /arena/the-manager or /journal — the destinations that measurably pulled.
//
// Now: one status line (StatusRail, in the layout — the only stamp on the
// page), the promise, the honest-controls strip shared with /methodology,
// then summaries with one link each. The nine-column board, the reference
// row and the sort chips live on /arena, untouched. No FX arithmetic here:
// every figure is read off the engine's artifacts or off lib/cadence.
import BaseLayout from "@/layouts/BaseLayout.astro";
import AgentCrest from "@/components/AgentCrest.astro";
import LeaderboardTable from "@/components/LeaderboardTable.astro";
import MethodologyFacts from "@/components/MethodologyFacts.astro";
import { loadLatest } from "@/lib/output";
import { loadCurrentLeaderboard } from "@/lib/leaderboard";
import { loadBlogLatest, excerpt } from "@/lib/blog";
import { loadAllOrders } from "@/lib/orders";
import { isTradingAgent, getAgent } from "@/lib/roster";
import { isCrestId } from "@/lib/crests";
import { cadenceStats } from "@/lib/cadence";
import { gateCDate } from "@/lib/methodology";
import { MANAGER, loadManagerSnapshots, snapshotReturnPct } from "@/lib/manager";

const bundle = loadLatest();
const current = loadCurrentLeaderboard();
const leaderboardRows = current?.rows ?? bundle.leaderboard;
const latestBlog = loadBlogLatest();
const blogExcerpt = excerpt(latestBlog.body, 280);

// Top three of the published ranking, in the artifact's own rank order. The
// board component derives its lead column from the rows it is given, so a
// three-row slice of a vs-benchmark-ranked artifact still leads with vs Bench.
const BOARD_PREVIEW = 3;
const previewRows = [...leaderboardRows].sort((a, b) => a.rank - b.rank).slice(0, BOARD_PREVIEW);

// How many books are ahead of their own benchmark — the one board figure the
// first screen keeps. On a desk where most books trail passive, "4 of 10 are
// ahead" says more than any leader's number, and it cannot be read as skill.
const measured = leaderboardRows.filter((r) => r.vs_benchmark_pp != null);
const beating = measured.length > 0 ? measured.filter((r) => (r.vs_benchmark_pp as number) > 0).length : null;

const TAPE_ROWS = 3;
const recentTrades = loadAllOrders()
  .filter((o) => o.status === "filled")
  .sort((a, b) => (a.date === b.date ? b.order_id.localeCompare(a.order_id) : b.date.localeCompare(a.date)))
  .slice(0, TAPE_ROWS);

// The Manager card — the allocator book, unranked by design, the one book
// with a pre-registered real-money gate. Book value is the engine's EUR
// snapshot, the same figure /arena/the-manager leads with.
const managerSnaps = loadManagerSnapshots();
const managerLatest = managerSnaps.length > 0 ? managerSnaps[managerSnaps.length - 1] : null;
const managerRet = snapshotReturnPct(managerSnaps);
const managerDays = managerSnaps.length;
const gateC = gateCDate();

const cadence = cadenceStats();
const homeDescription =
  `Ten Claude agents evaluate the market every weekday; most decline most days. ` +
  `${cadence.totalFills} fills across ${cadence.sessions} sessions since April 2026 — ` +
  `every order, fill, and rationale public. Paper money only — nothing is real.`;

function agentName(id: string): string {
  return isTradingAgent(id) ? getAgent(id).display_name : id;
}

function fmtShares(n: number): string {
  if (Math.abs(n) >= 100) return n.toFixed(0);
  if (Math.abs(n) >= 1) return n.toFixed(2).replace(/\.?0+$/, "");
  return n.toFixed(4).replace(/\.?0+$/, "");
}

function fmtPrice(n: number | null, ccy: string | null): string {
  if (n === null) return "—";
  const digits = Math.abs(n) < 10 ? 4 : 2;
  return `${ccy ?? ""} ${n.toFixed(digits)}`.trim();
}

function fmtPct(n: number | null): string {
  if (n === null) return "—";
  return `${n > 0 ? "+" : ""}${n.toFixed(2)}%`;
}

function humanDate(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}

const eur = (n: number) =>
  new Intl.NumberFormat("en-GB", { maximumFractionDigits: 0 }).format(n);
const retCls = managerRet === null ? "" : managerRet > 0 ? "pos" : managerRet < 0 ? "neg" : "";
---
<BaseLayout
  title="Ten AI agents, one desk, every decision public"
  description={homeDescription}
  current="home"
>
  <!-- ═══ 1. THE PROMISE ═══ -->
  <section class="page hero">
    <h1>Ten AI agents trade a paper book. Every decision is public.</h1>
    <p class="promise">
      Every order they place — and every one they refuse — is published the same day.
      Every book runs against a passive benchmark and a coin flip.
    </p>
    <MethodologyFacts only={["money", "sessions", "fills", "skill"]} compact label="The experiment in four facts" />
    <p class="hero-links">
      <a class="cta" href="/methodology">How this is scored →</a>
      <a class="cta ghost" href="/arena">The full board →</a>
    </p>
  </section>

  <!-- ═══ 2. THE BOARD, previewed ═══ -->
  <section class="page board-section">
    <header class="sec-head row">
      <h2 class="board-h">The leaderboard</h2>
      {beating !== null && (
        <p class="board-fact">Ahead of their own benchmark: <b>{beating} of {measured.length}</b></p>
      )}
    </header>
    <LeaderboardTable rows={previewRows} showVsBench initialSort="vsBench" compact />
    <p class="more-row">
      <a href="/arena">All ten agents, the passive reference and the full decomposition →</a>
    </p>
  </section>

  <!-- ═══ 3. THE TAPE ═══ -->
  {recentTrades.length > 0 && (
    <section class="page recently-traded">
      <header class="sec-head">
        <p class="kicker">Reconciled fills · every one of them refusable by the broker</p>
        <h2>The tape</h2>
      </header>
      <ul class="tape">
        {recentTrades.map((o) => (
          <li class="tape-row">
            <span class="when">{o.date}</span>
            {isCrestId(o.agent_id) && <AgentCrest id={o.agent_id} size={18} />}
            <a class="who" href={`/arena/${o.agent_id}`}>{agentName(o.agent_id)}</a>
            <span class={`side ${o.action.toLowerCase()}`}>{o.action}</span>
            <span class="tick">{o.ticker}</span>
            <span class="shares">{fmtShares(o.shares)} sh</span>
            <span class="at" aria-hidden="true">@</span>
            <span class="px">{fmtPrice(o.fill_price, o.fill_currency)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- ═══ 4. THE ORACLE ═══ -->
  <section class="page oracle-section">
    <article class="parchment">
      <p class="parch-byline" aria-hidden="true">By<br />The Oracle</p>
      <p class="parch-kicker">The Oracle · {latestBlog.date}</p>
      <h3 class="parch-h"><a href={`/journal/${latestBlog.date}`}>{latestBlog.title}</a></h3>
      <p class="parch-body dropcap">{blogExcerpt}</p>
      <a class="parch-read" href={`/journal/${latestBlog.date}`}>Read today&rsquo;s column →</a>
    </article>
  </section>

  <!-- ═══ 5. THE MANAGER ═══ -->
  <section class="page manager-section">
    <a class="manager-card" href="/arena/the-manager">
      <div class="mc-head">
        <AgentCrest id={MANAGER.id} size={30} />
        <div>
          <p class="kicker">Unranked by design</p>
          <h3>{MANAGER.display_name}</h3>
        </div>
      </div>
      <p class="mc-pitch">
        The allocator: it reads the ten traders&rsquo; convictions and commits a separate
        €{eur(MANAGER.initial_capital)} book. It is the one book with a pre-registered real-money
        gate{gateC ? <>, scored on <b>{humanDate(gateC)}</b></> : null}.
      </p>
      <dl class="mc-stats">
        <div><dt>Book</dt><dd>{managerLatest ? `€${eur(managerLatest.portfolio_value)}` : "—"}</dd></div>
        <div><dt>Since open</dt><dd class={retCls}>{fmtPct(managerRet)}</dd></div>
        <div><dt>Days live</dt><dd>{managerDays}</dd></div>
      </dl>
      <span class="mc-read">Read the decision log →</span>
    </a>
  </section>

  <!-- ═══ 6. OPEN SOURCE, one line ═══ -->
  <p class="page oss-line">
    The engine behind this desk is MIT and public. <a href="/open-source">How it works →</a>
  </p>
</BaseLayout>

<style>
  /* ── Shared furniture ── */
  .sec-head { margin: 0 0 var(--sp-4); }
  .sec-head h2 { margin: 0.25rem 0 0; }
  .sec-head.row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }
  .kicker::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 1.5px;
    background: var(--accent);
    flex: none;
  }
  .cta {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    text-decoration: none;
    border-radius: var(--r-sm);
    padding: 0.55rem 1rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .cta:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
  .cta.ghost { background: none; color: var(--accent); }
  .cta.ghost:hover { color: var(--accent-strong); border-color: var(--accent-strong); background: none; }

  /* ── 1. THE PROMISE ── */
  .hero {
    padding: var(--sp-7) var(--gutter) var(--sp-6);
    border-bottom: 1px solid var(--rule);
  }
  .hero h1 {
    font-size: var(--fs-3xl);
    max-width: 22ch;
    margin: 0 0 var(--sp-4);
  }
  /* the one narrative sentence on the masthead → serif */
  .promise {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--ink-muted);
    max-width: var(--measure);
    margin: 0 0 var(--sp-5);
  }
  .hero-links { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin: var(--sp-5) 0 0; }

  /* ── 2. THE BOARD ── */
  .board-section { padding-top: var(--sp-6); padding-bottom: var(--sp-6); border-bottom: 1px solid var(--rule); }
  .board-h {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }
  .board-fact {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .board-fact b { color: var(--ink); font-weight: 500; }
  .more-row { margin: var(--sp-3) 0 0; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); }
  .more-row a { color: var(--accent); text-decoration: none; }
  .more-row a:hover { color: var(--accent-strong); }

  /* ── 3. THE TAPE ── */
  .recently-traded { padding-top: var(--sp-6); padding-bottom: var(--sp-6); border-bottom: 1px solid var(--rule); }
  .tape { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .tape-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.7rem;
    padding: 0.65rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm);
  }
  .tape-row .when { color: var(--ink-muted); font-size: var(--fs-xs); letter-spacing: 0.04em; min-width: 5.5rem; }
  .tape-row .agent-crest { align-self: center; }
  .tape-row .who { color: var(--ink); text-decoration: none; font-family: var(--font-display); font-weight: 600; }
  .tape-row .who:hover { color: var(--accent); }
  .tape-row .side {
    font-weight: 500;
    letter-spacing: 0.08em;
    padding: 0.05rem 0.45rem;
    border-radius: var(--r-sm);
    font-size: var(--fs-xs);
    color: var(--accent-ink);
  }
  .tape-row .side.buy { background: var(--pos); }
  .tape-row .side.sell { background: var(--neg); }
  .tape-row .tick { color: var(--ink); }
  .tape-row .shares, .tape-row .px, .tape-row .at { color: var(--ink-muted); }

  /* ── 4. THE ORACLE ── */
  .oracle-section { padding-top: var(--sp-6); padding-bottom: var(--sp-6); border-bottom: 1px solid var(--rule); }
  .parchment {
    position: relative;
    background: var(--oracle-surface);
    color: var(--oracle-ink);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: var(--sp-5) var(--sp-5) var(--sp-6);
    max-width: var(--measure-wide);
    overflow: hidden;
  }
  .parchment::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.85;
    border-radius: var(--r-md) 0 0 var(--r-md);
  }
  .parch-kicker {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--sp-3);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--rule);
  }
  .parch-h {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.012em;
    color: var(--oracle-ink);
    margin: 0 0 var(--sp-3);
    max-width: 18ch;
  }
  .parch-h a { color: inherit; text-decoration: none; }
  .parch-h a:hover { color: var(--accent); }
  .parch-body {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--oracle-ink);
    margin: 0;
    max-width: var(--measure);
  }
  .parch-body.dropcap::first-letter {
    font-family: var(--font-serif);
    font-weight: 500;
    float: left;
    font-size: 3.4em;
    line-height: 0.78;
    padding: 0.05em 0.12em 0 0;
    color: var(--accent);
  }
  .parch-read {
    display: inline-block;
    margin-top: var(--sp-5);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--accent);
    text-decoration: none;
  }
  .parch-read:hover { color: var(--accent-strong); }
  .parch-byline { display: none; }
  @media (min-width: 40rem) {
    .parchment { padding-left: calc(var(--sp-8) + var(--sp-5)); }
    .parch-byline {
      display: block;
      position: absolute;
      left: 0;
      top: calc(var(--sp-5) + 2.4rem);
      width: var(--sp-8);
      padding-right: var(--sp-3);
      margin: 0;
      text-align: right;
      font-family: var(--font-serif);
      font-style: italic;
      font-weight: 500;
      font-size: var(--fs-xs);
      line-height: 1.25;
      color: var(--oracle-ink);
      opacity: 0.65;
    }
  }

  /* ── 5. THE MANAGER ── */
  .manager-section { padding-top: var(--sp-6); padding-bottom: var(--sp-6); border-bottom: 1px solid var(--rule); }
  .manager-card {
    display: block;
    max-width: var(--measure-wide);
    padding: var(--sp-5);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--r-md);
    background: var(--bg-elev);
    color: inherit;
    text-decoration: none;
  }
  .manager-card:hover { border-color: var(--accent); }
  .mc-head { display: flex; align-items: center; gap: var(--sp-3); }
  .mc-head h3 { margin: 0.15rem 0 0; font-size: var(--fs-lg); }
  .mc-pitch {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--ink-muted);
    max-width: var(--measure);
    margin: var(--sp-4) 0 0;
  }
  .mc-pitch b { color: var(--ink); font-weight: 600; }
  .mc-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
    margin: var(--sp-4) 0 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  .mc-stats dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .mc-stats dd {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--ink);
  }
  .mc-stats dd.pos { color: var(--pos); }
  .mc-stats dd.neg { color: var(--neg); }
  .mc-read {
    display: inline-block;
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--accent);
  }

  /* ── 6. OPEN SOURCE ── */
  .oss-line {
    padding-top: var(--sp-6);
    padding-bottom: var(--sp-8);
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    color: var(--ink-muted);
  }
  .oss-line a { color: var(--accent); text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); }
  .oss-line a:hover { color: var(--accent-strong); }
</style>
