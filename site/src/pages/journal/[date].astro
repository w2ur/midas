---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listBlogDates, loadBlogByDate, renderBlogHtml, excerpt } from "@/lib/blog";

export function getStaticPaths() {
  return listBlogDates().map((date) => ({ params: { date } }));
}

const { date } = Astro.params as { date: string };
const post = loadBlogByDate(date);
const html = renderBlogHtml(post.body);
const description = excerpt(post.body, 200);

const all = listBlogDates();
const idx = all.indexOf(date);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

function humanDate(iso: string): string {
  return new (globalThis.Date)(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}

const canonicalUrl = new URL(`/journal/${post.date}`, Astro.site ?? "https://midas.revah.paris").toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  datePublished: `${post.date}T00:00:00Z`,
  author: { "@type": "Person", name: "The Oracle" },
  publisher: { "@type": "Organization", name: "Midas" },
  mainEntityOfPage: canonicalUrl,
};
---
<BaseLayout title={post.title} current="journal" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="page">
    <article class="oracle-column">
      <div class="article">
        <p class="oc-kicker">The Oracle · {humanDate(post.date)}</p>
        <h1>{post.title}</h1>
        <p class="oc-byline"><span>By</span> <span>The Oracle</span></p>
        <div class="prose" set:html={html}></div>
      </div>
    </article>

    <nav class="prevnext" aria-label="Column navigation">
      {prev ? <a class="prev" href={`/journal/${prev}`}>← Previous dispatch</a> : <span></span>}
      {next ? <a class="next" href={`/journal/${next}`}>Next dispatch →</a> : <span></span>}
    </nav>
  </div>
</BaseLayout>
<style>
  /* ── Parchment panel: the Oracle's warm human surface ── */
  .oracle-column {
    --gutter: 1.5rem;
    position: relative;
    max-width: calc(var(--measure) + 9rem);
    margin: 0 auto;
    padding: 1.75rem 1.5rem 2rem var(--gutter);
    background: var(--oracle-surface);
    color: var(--oracle-ink);
    font-family: var(--font-serif);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  /* left amber accent rule */
  .oracle-column::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
  }
  .oracle-column .article {
    position: relative;
    max-width: var(--measure);
    margin: 0;
  }

  /* mono kicker */
  .oc-kicker {
    margin: 0 0 0.85rem;
    padding-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--oracle-ink) 18%, transparent);
  }

  /* serif title — the human voice */
  .oracle-column .article h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    margin: 0 0 0.4rem;
    color: var(--oracle-ink);
  }

  /* hanging byline — static (inline) on small screens, hung in the gutter on wide */
  .oc-byline {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-sm);
    line-height: 1.25;
    color: color-mix(in srgb, var(--oracle-ink) 70%, var(--oracle-surface));
  }

  /* ── Body (Oracle prose) — serif, capped at the measure ── */
  .oracle-column .prose {
    font-family: var(--font-serif);
    color: var(--oracle-ink);
  }
  .oracle-column .prose :global(h1) { display: none; }
  .oracle-column .prose :global(h2),
  .oracle-column .prose :global(h3),
  .oracle-column .prose :global(h4) {
    font-family: var(--font-serif);
    color: var(--oracle-ink);
    margin-top: 2rem;
  }
  /* drop cap on the first paragraph */
  .oracle-column .prose :global(p:first-of-type)::first-letter {
    float: left;
    margin: 0.15rem 0.55rem 0 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 3.4rem;
    line-height: 0.74;
    color: var(--accent);
  }
  .oracle-column .prose :global(a) {
    color: var(--oracle-ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .oracle-column .prose :global(a:hover) { color: var(--accent); }
  .oracle-column .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    margin: 1.5rem 0;
    padding: 0.25rem 1rem;
    font-style: italic;
    color: color-mix(in srgb, var(--oracle-ink) 80%, var(--oracle-surface));
  }
  .oracle-column .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: color-mix(in srgb, var(--oracle-ink) 9%, transparent);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .oracle-column .prose :global(pre) {
    background: color-mix(in srgb, var(--oracle-ink) 9%, transparent);
    padding: 1rem;
    overflow-x: auto;
    border-radius: var(--r-md);
  }
  .oracle-column .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: var(--fs-sm);
  }
  .oracle-column .prose :global(th),
  .oracle-column .prose :global(td) {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid color-mix(in srgb, var(--oracle-ink) 20%, transparent);
    color: var(--oracle-ink);
  }
  .oracle-column .prose :global(th) {
    color: color-mix(in srgb, var(--oracle-ink) 75%, var(--oracle-surface));
  }

  /* desktop: open the left gutter and hang the byline into it */
  @media (min-width: 40rem) {
    .oracle-column {
      --gutter: 5.5rem;
      padding: 2.75rem 3rem 3rem var(--gutter);
    }
    .oc-byline {
      position: absolute;
      top: 2.1rem;
      left: -4.5rem;
      width: 3.5rem;
      margin: 0;
      text-align: right;
    }
    .oc-byline span { display: block; }
  }

  /* ── Prev / next column nav (mono, 44px tap targets) ── */
  .prevnext {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: stretch;
    max-width: calc(var(--measure) + 9rem);
    margin: 1.5rem auto 0;
  }
  .prevnext a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .prevnext a:hover { color: var(--accent); }
  .prevnext a.next { margin-left: auto; text-align: right; }
</style>
