---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listBlogDates, loadBlogByDate, excerpt } from "@/lib/blog";

const dates = listBlogDates().slice().reverse();
const entries = dates.map((d) => {
  const p = loadBlogByDate(d);
  return { date: d, title: p.title, slug: p.slug, excerpt: excerpt(p.body, 220) };
});

function humanDate(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}
---
<BaseLayout title="The Oracle" current="journal" description="The Oracle's daily column on the Midas experiment.">
  <section class="page">
    <header class="oc-head">
      <p class="kicker"><span class="tk" aria-hidden="true"></span>Daily dispatches</p>
      <h2>The Oracle</h2>
    </header>
    <p class="lede">A daily column on what the agents did and what it means.</p>

    <ol class="oracle-index">
      {entries.map((e) => (
        <li class="oc-entry">
          <span class="oc-tick" aria-hidden="true"></span>
          <a class="oc-link" href={`/journal/${e.date}`}>
            <span class="oc-date">{humanDate(e.date)}</span>
            <span class="oc-title">{e.title}</span>
            <span class="oc-excerpt">{e.excerpt}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
<style>
  /* ── Section head: mono amber kicker + display heading (homepage pattern) ── */
  .oc-head { margin: 0 0 0.4rem; }
  .oc-head h2 { margin: 0; }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kicker .tk {
    flex: 0 0 auto;
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--accent);
  }
  .lede {
    max-width: var(--measure);
    margin: 0 0 var(--sp-6, 2rem);
    color: var(--ink-muted);
    font-size: var(--fs-md);
  }

  /* ── Teletype timeline: a reverse-chron session log of columns ── */
  .oracle-index {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  .oc-entry {
    position: relative;
    margin-left: 0.5rem;
    padding: 1.25rem 0 1.25rem 1.5rem;
    border-left: 1px solid var(--rule);
  }
  .oc-entry:first-child { padding-top: 0.5rem; }
  /* the amber session tick, punched through the spine */
  .oc-tick {
    position: absolute;
    left: -4px;
    top: 1.85rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg);
  }
  .oc-entry:first-child .oc-tick { top: 1.1rem; }

  .oc-link {
    display: block;
    padding: 0.1rem 0;
    color: inherit;
    text-decoration: none;
  }
  .oc-date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .oc-title {
    display: block;
    margin: 0.3rem 0 0.35rem;
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    line-height: 1.15;
    color: var(--ink);
  }
  .oc-link:hover .oc-title { color: var(--accent); }
  .oc-excerpt {
    display: block;
    font-family: var(--font-serif);
    color: var(--ink-muted);
  }
</style>
