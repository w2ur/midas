---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ossStats } from "@/lib/oss-stats";
import { BROKER_RAILS, WATCHER_RAILS } from "@/lib/rails";

const stats = ossStats();
const REPO = "https://github.com/w2ur/midas-core";
const LIVE_REPO = "https://github.com/w2ur/midas";

function fmtInt(n: number): string {
  return n.toLocaleString("en-GB");
}
---
<BaseLayout
  title="The engine is open source"
  description="Midas runs on an open multi-agent fund-manager engine: agents author orders, a broker enforces the safety rails. MIT-licensed, reproducible, and proven on a desk that publishes its own results."
  current="open-source"
>
  <!-- ═══ HERO ═══ -->
  <section class="page os-hero">
    <p class="kicker">Open source · MIT</p>
    <h1>The engine is open source.</h1>
    <p class="lede">
      Midas is not a bot you subscribe to. It is a framework: agents author decisions to a
      directory on disk, and a broker — a separate process holding no persona and taking no
      advice — enforces the rails and executes them. That engine is public, and this desk is
      the proof that it runs.
    </p>
    <p class="os-cta">
      <a class="btn-primary" href={REPO}>midas-core on GitHub →</a>
      <a class="btn-ghost" href={`${REPO}#readme`}>Read the quickstart</a>
    </p>
  </section>

  <!-- ═══ COUNTERS ═══ -->
  <section class="page os-counters" aria-label="Live figures">
    <div class="os-fig"><b>{fmtInt(stats.sessions)}</b><span>sessions</span></div>
    <div class="os-fig"><b>{fmtInt(stats.fills)}</b><span>fills executed</span></div>
    <div class="os-fig"><b>{stats.brokerRails}</b><span>broker reason codes</span></div>
    <div class="os-fig"><b>MIT</b><span>licence</span></div>
  </section>

  <!-- ═══ BRAIN / HANDS ═══ -->
  <section class="page os-band">
    <header class="sec-head">
      <p class="kicker">The architecture</p>
      <h2>Brain writes. Hands execute.</h2>
    </header>
    <p class="os-body">
      The Brain holds no credentials and touches no broker. It reads prices from a committed
      store, reasons, and appends orders to an outbox. The Hands read that outbox, check every
      order against the rails, and write the outcome — filled or rejected, with a reason — to an
      inbox. The boundary is a directory of append-only JSONL files, which is why swapping the
      paper broker for a real one is a swap and not a rewrite.
    </p>

    <svg class="os-diagram" viewBox="0 0 720 190" role="img"
         aria-label="Agents write orders to an outbox; the broker applies safety rails and writes fills or rejections to an inbox, which mutates portfolios. Conditional orders wait in pending until a watcher fires them back through the broker.">
      <defs>
        <marker id="os-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--rule-strong)" />
        </marker>
      </defs>
      <g class="os-node">
        <rect x="8" y="60" width="126" height="46" rx="4" />
        <text x="71" y="79">Agents</text>
        <text x="71" y="95" class="os-sub">Brain</text>
      </g>
      <g class="os-node">
        <rect x="176" y="60" width="126" height="46" rx="4" />
        <text x="239" y="79">outbox</text>
        <text x="239" y="95" class="os-sub">*.jsonl</text>
      </g>
      <g class="os-node os-gate">
        <rect x="344" y="52" width="140" height="62" rx="4" />
        <text x="414" y="77">paper broker</text>
        <text x="414" y="93" class="os-sub">{stats.brokerRails} reason codes</text>
      </g>
      <g class="os-node">
        <rect x="526" y="16" width="150" height="46" rx="4" />
        <text x="601" y="35">inbox</text>
        <text x="601" y="51" class="os-sub">filled / rejected</text>
      </g>
      <g class="os-node">
        <rect x="526" y="104" width="150" height="46" rx="4" />
        <text x="601" y="123">portfolios</text>
        <text x="601" y="139" class="os-sub">apply_trade</text>
      </g>
      <g class="os-edge" marker-end="url(#os-arrow)">
        <path d="M134 83 H170" />
        <path d="M302 83 H338" />
        <path d="M484 83 C 505 83, 505 39, 520 39" />
        <path d="M484 83 C 505 83, 505 127, 520 127" />
      </g>
    </svg>
  </section>

  <!-- ═══ THE RAILS ═══ -->
  <section class="page os-band">
    <header class="sec-head">
      <p class="kicker">What the broker enforces</p>
      <h2>Safety lives in the broker, not the prompt.</h2>
    </header>
    <p class="os-body">
      A persona is aspirational. It can be coaxed, confused, or simply wrong. So none of the
      constraints live in the prompt — every one of them is a check the broker runs at fill
      time, and a rejected order carries the code that stopped it. These are all of them.
    </p>
    <dl class="os-rails">
      {BROKER_RAILS.map((rail) => (
        <div class="os-rail">
          <dt>{rail.code}</dt>
          <dd>{rail.blurb}</dd>
        </div>
      ))}
    </dl>
    <p class="os-note">
      The conditional-order watcher is a second enforcement point and owns one more code:
      {WATCHER_RAILS.map((rail) => (
        <> <b>{rail.code}</b> — {rail.blurb}</>
      ))}
    </p>
  </section>

  <!-- ═══ PROVENANCE ═══ -->
  <section class="page os-band">
    <header class="sec-head">
      <p class="kicker">Provenance</p>
      <h2>Fills since June 2026 know which commit produced them.</h2>
    </header>
    <p class="os-body">
      Every fill from 2026-06-29 onward is stamped with <code>executed_sha</code> — the git
      commit the broker was running when it executed (122 of the 271 filled rows, 45%; the
      first ten weeks of the ledger predate the stamping and have no <code>executed_sha</code>
      to check out). Prices and index membership are committed to the repository, and a trading
      session makes no outbound HTTP calls, so checking out that commit re-derives the exact
      order and the exact price store the broker saw. Nothing about a stamped past decision
      depends on what a data provider says today.
    </p>
    <pre class="os-code"><code>git checkout &lt;executed_sha&gt;   # the desk, exactly as it was at fill time</code></pre>
  </section>

  <!-- ═══ WHAT'S OPEN ═══ -->
  <section class="page os-band">
    <header class="sec-head">
      <p class="kicker">Scope</p>
      <h2>Both repositories are open.</h2>
    </header>
    <div class="os-split">
      <div>
        <h3>The framework</h3>
        <p>
          <code>midas-core</code> — the Brain/Hands broker, the
          <code>roster.yaml</code> config that drives an entire cast (traders, a narrator, an
          optional allocator, each with its own broker-enforced rails), the backtest and
          baseline machinery, a runnable demo desk, and the session protocol a desk of your
          own would implement. MIT, on PyPI.
        </p>
      </div>
      <div>
        <h3>This desk</h3>
        <p>
          <code>w2ur/midas</code> — the live ledger: every order, fill, snapshot and journal
          entry, the price store they were valued against, and the whole commit history that
          produced them (provenance above). Code is MIT; vendor price data and narrative
          content are published for inspection, not for redistribution — see
          <a href={`${LIVE_REPO}/blob/main/NOTICE.md`}>NOTICE.md</a> for exactly where the
          line sits.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ WHERE THIS SITS ═══ -->
  <section class="page os-band">
    <header class="sec-head">
      <p class="kicker">Neighbours</p>
      <h2>Where this sits.</h2>
    </header>
    <p class="os-body">
      If you want a research framework where analyst agents debate a thesis, look at
      <a href="https://github.com/TauricResearch/TradingAgents">TradingAgents</a>. If you want a
      personal cockpit that trades your own broker account, look at
      <a href="https://github.com/TraderAlice/OpenAlice">OpenAlice</a>. Both are good at what
      they are for.
    </p>
    <p class="os-body">
      Midas is the third thing: an accountability harness. The rails live in the broker rather
      than the prompt, fills since June 2026 carry the commit they executed against, and the desk publishes
      its own results against a passive benchmark <em>and</em> a coin-flip control — every
      weekday since 17 April 2026. The point is not that the agents are good. The point is that
      you can check.
    </p>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="page os-tail">
    <h2>Stand up your own desk.</h2>
    <p class="os-body">
      The quickstart takes you from a clone to a real fill and a real rejection — one order that
      clears, one deliberately oversized order that trips the notional rail.
    </p>
    <p class="os-cta">
      <a class="btn-primary" href={REPO}>midas-core on GitHub →</a>
      <a class="btn-ghost" href="/methodology">How this experiment is run</a>
    </p>
    <p class="os-body">
      The quickstart gets you a fill. Running an autonomous session — agents authoring, the
      broker filling, snapshots, baselines, narrative — is described step by step in
      <a href={`${REPO}/blob/main/docs/session-protocol.md`}>the
      session protocol</a>, which is deliberately model-agnostic: it says what has to happen
      and in what order, not what has to be driving it.
    </p>
  </section>
</BaseLayout>

<style>
  .sec-head { margin: 0 0 var(--sp-4); }
  .sec-head h2 { margin: 0.25rem 0 0; }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }
  .kicker::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 1.5px;
    background: var(--accent);
    flex: none;
  }

  .os-hero { padding: var(--sp-7) var(--gutter) var(--sp-6); }
  .os-hero h1 { font-size: var(--fs-3xl); max-width: 16ch; margin: var(--sp-3) 0 var(--sp-4); }
  .lede {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--ink-muted);
    max-width: var(--measure);
    margin: 0;
  }

  .os-cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin: var(--sp-5) 0 0; }
  .btn-primary,
  .btn-ghost {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    text-decoration: none;
    border-radius: var(--r-sm);
    padding: 0.55rem 1rem;
    border: 1px solid var(--accent);
  }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); }
  .btn-ghost { color: var(--accent); background: none; }
  .btn-ghost:hover { color: var(--accent-strong); border-color: var(--accent-strong); }

  .os-counters {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
    padding: var(--sp-5) var(--gutter);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .os-counters { grid-template-columns: repeat(4, 1fr); }
  }
  .os-fig { display: flex; flex-direction: column; gap: 0.2rem; }
  .os-fig b {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-2xl);
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }
  .os-fig span {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .os-band { padding: var(--sp-7) var(--gutter); border-bottom: 1px solid var(--rule); }
  .os-body {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--ink-muted);
    max-width: var(--measure);
    margin: 0 0 var(--sp-4);
  }
  .os-body:last-child { margin-bottom: 0; }
  .os-body a { color: var(--accent); }
  .os-body em { color: var(--ink); font-style: italic; }
  .os-body code,
  .os-note code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-elev2);
    padding: 0.1em 0.35em;
    border-radius: var(--r-sm);
  }

  .os-diagram { width: 100%; max-width: var(--measure-wide); height: auto; margin-top: var(--sp-3); }
  .os-node rect { fill: var(--bg-elev); stroke: var(--rule-strong); stroke-width: 1; }
  .os-node.os-gate rect { stroke: var(--accent); }
  .os-node text {
    fill: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
    text-anchor: middle;
  }
  .os-node text.os-sub { fill: var(--ink-muted); font-size: 11px; }
  .os-edge path { fill: none; stroke: var(--rule-strong); stroke-width: 1.2; }

  /* Two columns above 60rem: 19 single-file rows ran 1,378px — the tallest
     block on the page — for content that is a reference list, not prose. */
  .os-rails {
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
  }
  @media (min-width: 60rem) {
    .os-rails {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--sp-6);
    }
  }
  .os-rail {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    align-content: start;
  }
  .os-rail dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .os-rail dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .os-note {
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: var(--measure-wide);
    margin: var(--sp-4) 0 0;
  }
  .os-note b { font-family: var(--font-mono); font-weight: 500; color: var(--accent); }

  .os-code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    background: var(--bg-elev2);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    padding: var(--sp-3) var(--sp-4);
    margin: 0;
    overflow-x: auto;
    max-width: var(--measure-wide);
  }

  .os-split { display: grid; gap: var(--sp-5); }
  @media (min-width: 48rem) {
    .os-split { grid-template-columns: 1fr 1fr; gap: var(--sp-6); }
  }
  .os-split h3 {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-2);
  }
  .os-split p {
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }

  .os-tail { padding: var(--sp-7) var(--gutter) var(--sp-8); }
  .os-tail h2 { margin: 0 0 var(--sp-3); }
</style>
