---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listDates as listOutputDates, loadByDate } from "@/lib/output";
import { listBlogDates, loadBlogByDate } from "@/lib/blog";
import { isTradingAgent, getAgent } from "@/lib/roster";

const blogDates = new Set(listBlogDates());
const dates = listOutputDates().slice().reverse();

type Row = {
  date: string;
  leaderName: string;
  leaderPct: number;
  oracleTitle: string | null;
};

const rows: Row[] = dates.map((d) => {
  const b = loadByDate(d);
  const top = b.leaderboard[0];
  const leaderName = top
    ? (isTradingAgent(top.agent) ? getAgent(top.agent).display_name : top.agent)
    : "—";
  const leaderPct = top?.return_pct ?? 0;
  const oracleTitle = blogDates.has(d) ? loadBlogByDate(d).title : null;
  return { date: d, leaderName, leaderPct, oracleTitle };
});

function humanDate(iso: string): string {
  const [y, m, d] = iso.split("-").map(Number);
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-GB", {
    weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}

function fmtPct(n: number): string {
  const sign = n > 0 ? "+" : n < 0 ? "" : "";
  return `${sign}${n.toFixed(2)}%`;
}

function monthKey(iso: string): string {
  const [y, m] = iso.split("-").map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString("en-GB", {
    month: "long", year: "numeric", timeZone: "UTC",
  });
}

const groups = new Map<string, Row[]>();
for (const r of rows) {
  const key = monthKey(r.date);
  const list = groups.get(key) ?? [];
  list.push(r);
  groups.set(key, list);
}
---
<BaseLayout title="Archive" current="archive" description="Every day the Midas experiment has run. Browse the paper.">
  <section class="page">
    <p class="eyebrow">Time travel</p>
    <h1>The Archive</h1>
    <p class="lede">
      Every day the experiment has run gets its own front page. Pick a date to see the
      leaderboard, the Oracle&rsquo;s column, and the tape as they stood.
    </p>

    {Array.from(groups.entries()).map(([month, items]) => (
      <section class="month">
        <h2>{month}</h2>
        <ul class="entry-list">
          {items.map((r) => {
            const cls = r.leaderPct > 0 ? "pos" : r.leaderPct < 0 ? "neg" : "";
            return (
              <li>
                <div class="meta">{humanDate(r.date)}</div>
                <div class="title">
                  <a href={`/archive/${r.date}`}>
                    {r.oracleTitle ?? `Session · ${r.date}`}
                  </a>
                </div>
                <div class="summary">
                  <span>Top: <strong>{r.leaderName}</strong></span>
                  <span class={`num ${cls}`}>{fmtPct(r.leaderPct)}</span>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
<style>
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--fs-md); margin-bottom: 2rem; }
  .month { margin-bottom: 2.5rem; }
  .month h2 { font-size: var(--fs-lg); margin: 0 0 0.5rem; }
  .entry-list .summary {
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--ink-muted);
    margin-top: 0.25rem;
  }
  .entry-list .summary .num { font-variant-numeric: tabular-nums; }
</style>
