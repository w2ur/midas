---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SessionCalendar from "@/components/SessionCalendar.astro";
import { listDates as listOutputDates, loadByDate } from "@/lib/output";
import { listBlogDates, loadBlogByDate } from "@/lib/blog";
import { isTradingAgent, getAgent } from "@/lib/roster";

const blogDates = new Set(listBlogDates());
const dates = listOutputDates().slice().reverse();

type Row = {
  date: string;
  leaderName: string;
  leaderPct: number;
  oracleTitle: string | null;
};

const rows: Row[] = dates.map((d) => {
  const b = loadByDate(d);
  const top = b.leaderboard[0];
  const leaderName = top
    ? (isTradingAgent(top.agent) ? getAgent(top.agent).display_name : top.agent)
    : "—";
  const leaderPct = top?.return_pct ?? 0;
  const oracleTitle = blogDates.has(d) ? loadBlogByDate(d).title : null;
  return { date: d, leaderName, leaderPct, oracleTitle };
});

function stampDay(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    day: "2-digit", month: "short", timeZone: "UTC",
  });
}

function weekdayShort(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    weekday: "short", timeZone: "UTC",
  });
}

function fmtPct(n: number): string {
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)}%`;
}

function monthKey(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", {
    month: "long", year: "numeric", timeZone: "UTC",
  });
}

const groups = new Map<string, Row[]>();
for (const r of rows) {
  const key = monthKey(r.date);
  const list = groups.get(key) ?? [];
  list.push(r);
  groups.set(key, list);
}
---
<BaseLayout title="Archive" current="archive" description="Every day the Midas experiment has run. Browse the paper.">
  <section class="page">
    <p class="eyebrow">Session log</p>
    <h1>The Archive</h1>
    <p class="lede">
      Every day the experiment has run gets its own front page. Pick a date to see the
      leaderboard, the Oracle&rsquo;s column, and the tape as they stood.
    </p>

    <SessionCalendar days={rows} />

    <details class="full-log">
      <summary>
        <span class="fl-open">Browse as a list</span>
        <span class="fl-n">{rows.length} sessions</span>
      </summary>

    {Array.from(groups.entries()).map(([month, items]) => (
      <section class="month">
        <header class="month-head">
          <h2>{month}</h2>
          <span class="count num">{items.length} {items.length === 1 ? "session" : "sessions"}</span>
        </header>
        <ol class="session-log">
          {items.map((r) => {
            const cls = r.leaderPct > 0 ? "pos" : r.leaderPct < 0 ? "neg" : "";
            return (
              <li class="session">
                <a class="session-link" href={`/archive/${r.date}`}>
                  <span class="stamp">
                    <span class="day num">{stampDay(r.date)}</span>
                    <span class="dow">{weekdayShort(r.date)}</span>
                    <span class="tick" aria-hidden="true"></span>
                  </span>
                  <span class="entry">
                    <span class="title">{r.oracleTitle ?? `Session · ${r.date}`}</span>
                    <span class="summary">
                      <span class="top">Top &middot; <strong>{r.leaderName}</strong></span>
                      <span class={`num pct ${cls}`}>{fmtPct(r.leaderPct)}</span>
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
    </details>
  </section>
</BaseLayout>
<style>
  .lede {
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: var(--fs-md);
    margin-bottom: var(--sp-6);
  }

  /* ── The complete list, kept below the calendar ──
     A <details> rather than a client-side toggle so the whole record is still
     in the DOM for crawlers and for a no-JS reader, just not unrolled on
     arrival. */
  .full-log { margin-top: var(--sp-6); }
  .full-log > summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .full-log > summary::-webkit-details-marker { display: none; }
  .full-log > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fl-open { color: var(--accent); }
  .fl-n { color: var(--ink-muted); font-variant-numeric: tabular-nums; }

  .month { margin-bottom: var(--sp-7); }
  .month-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    margin: var(--sp-6) 0 var(--sp-2);
    padding-bottom: var(--sp-2);
    border-bottom: 2px solid var(--rule-strong);
  }
  .month-head h2 { font-size: var(--fs-lg); margin: 0; }
  .month-head .count {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  /* ── Teletype session-log timeline ── */
  .session-log { list-style: none; margin: 0; padding: 0; }

  .session-link {
    display: grid;
    grid-template-columns: minmax(4.75rem, auto) 1fr;
    gap: 0 var(--sp-4);
    align-items: stretch;
    text-decoration: none;
    color: var(--ink);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--rule);
  }
  .session:last-child .session-link { border-bottom: 0; }
  .session-link:hover { color: var(--ink); }
  .session-link:hover .title { color: var(--accent); }

  .stamp {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    padding-right: var(--sp-4);
    border-right: 1px solid var(--rule);
    font-family: var(--font-mono);
    text-align: right;
  }
  .stamp .day {
    font-size: var(--fs-sm);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stamp .dow {
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .stamp .tick {
    position: absolute;
    top: 0.15rem;
    right: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: var(--r-pill);
    background: var(--accent);
    box-shadow: var(--phosphor);
  }

  .entry { min-width: 0; display: flex; flex-direction: column; gap: var(--sp-1); }
  .entry .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-md);
    line-height: var(--lh-tight);
    overflow-wrap: anywhere;
  }
  .entry .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
  .entry .summary .top strong { color: var(--ink); font-weight: 700; }
  .entry .summary .pct { font-variant-numeric: tabular-nums; }
</style>
