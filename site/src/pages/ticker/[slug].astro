---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AgentCrest from "@/components/AgentCrest.astro";
import { buildTickerIndex, tickerSlug, loadAllOrders, type Order } from "@/lib/orders";
import { isTradingAgent, getAgent } from "@/lib/roster";
import { isCrestId } from "@/lib/crests";
import { tickerName } from "@/lib/tickers";
import { MANAGER, loadManagerOrdersAsOrders } from "@/lib/manager";

// The Manager's channels are public since 2026-07-24: its orders join the
// per-ticker history, and its tickers generate pages — a manager-only ticker
// must never leave a dead link on the dossier. (The loader lives in lib/manager
// because getStaticPaths is hoisted and only sees module imports.)
export function getStaticPaths() {
  const idx = buildTickerIndex();
  for (const o of loadManagerOrdersAsOrders()) {
    const slug = tickerSlug(o.ticker);
    if (!idx.has(slug)) idx.set(slug, o.ticker);
  }
  return Array.from(idx.entries()).map(([slug, ticker]) => ({
    params: { slug },
    props: { ticker },
  }));
}

const { ticker } = Astro.props;
const { slug } = Astro.params as { slug: string };
const name = tickerName(ticker);

const all = [...loadAllOrders(), ...loadManagerOrdersAsOrders()].filter((o) => o.ticker === ticker);
all.sort((a, b) => (a.date === b.date ? a.order_id.localeCompare(b.order_id) : b.date.localeCompare(a.date)));

const byAgent = new Map<string, Order[]>();
for (const o of all) {
  const arr = byAgent.get(o.agent_id) ?? [];
  arr.push(o);
  byAgent.set(o.agent_id, arr);
}
const agentsTouched = Array.from(byAgent.keys());

const filledCount = all.filter((o) => o.status === "filled").length;
const rejectedCount = all.filter((o) => o.status === "rejected").length;

function displayName(id: string): string {
  if (id === MANAGER.id) return MANAGER.display_name;
  return isTradingAgent(id) ? getAgent(id).display_name : id;
}

function fmtShares(n: number): string {
  if (Math.abs(n) >= 100) return n.toFixed(0);
  if (Math.abs(n) >= 1) return n.toFixed(2).replace(/\.?0+$/, "");
  return n.toFixed(4).replace(/\.?0+$/, "");
}

function fmtPrice(n: number | null, ccy: string | null): string {
  if (n === null) return "—";
  const digits = Math.abs(n) < 10 ? 4 : 2;
  return `${ccy ?? ""} ${n.toFixed(digits)}`.trim();
}
---
<BaseLayout title={ticker} current="arena" description={`Trade history across agents for ${ticker}.`}>
  <article class="page ticker-page">
    <header>
      <p class="kicker">Ticker · {slug}</p>
      <h1 class="ticker-symbol">{ticker}</h1>
      {name && <p class="name">{name}</p>}
      <p class="lede">
        Every order any agent wrote for this ticker, filled or rejected. One row per order.
      </p>
    </header>

    <section class="stats">
      <dl>
        <div><dt>Agents</dt><dd class="num">{agentsTouched.length}</dd></div>
        <div><dt>Fills</dt><dd class="num">{filledCount}</dd></div>
        <div><dt>Rejected</dt><dd class="num">{rejectedCount}</dd></div>
      </dl>
    </section>

    <section class="orders">
      <h2>Orders</h2>
      <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Agent</th>
            <th>Action</th>
            <th class="num">Shares</th>
            <th class="num">Fill</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {all.map((o) => (
            <tr class={o.status}>
              <td class="date">{o.date}</td>
              <td class="agent" data-agent={o.agent_id}>
                {isCrestId(o.agent_id) && <AgentCrest id={o.agent_id} size={18} />}
                <a href={`/arena/${o.agent_id}`}>{displayName(o.agent_id)}</a>
              </td>
              <td><span class={`pill ${o.action.toLowerCase()}`}>{o.action}</span></td>
              <td class="num">{fmtShares(o.shares)}</td>
              <td class="num">{fmtPrice(o.fill_price, o.fill_currency)}</td>
              <td>
                {o.status === "filled" && <span class="pill filled">filled</span>}
                {o.status === "rejected" && <span class="pill rejected" title={o.reject_reason ?? ""}>rejected</span>}
                {o.status === "pending" && <span class="pill pending">pending</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </section>

    <p class="back"><a href="/feed">← Today&rsquo;s feed</a></p>
  </article>
</BaseLayout>
<style>
  .kicker {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 var(--sp-2, 0.5rem);
  }
  .ticker-symbol {
    font-family: var(--font-mono);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight, 1.15);
    margin: 0 0 0.15em;
    overflow-wrap: anywhere;
  }
  .name { font-size: var(--fs-md); color: var(--ink-muted); margin: 0 0 var(--sp-4, 1rem); font-style: italic; }
  .lede { max-width: var(--measure); color: var(--ink-muted); font-size: var(--fs-md); margin-bottom: var(--sp-6, 2rem); }

  .stats dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 0 var(--sp-6, 2rem);
    border-bottom: 1px solid var(--rule);
  }
  .stats dl div { padding: var(--sp-3, 0.75rem) var(--sp-4, 1rem); border-right: 1px solid var(--rule); }
  .stats dl div:last-child { border-right: 0; }
  .stats dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-1, 0.25rem);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-md);
    color: var(--ink);
  }

  /* Orders table caps to --page-max via the .page wrapper. Numeric cells use
     the shared .num class (mono + tabular). Wrapping is allowed on the text
     columns so the table never forces horizontal overflow at 360px. */
  .orders { margin-top: var(--sp-6, 2rem); }
  /* Contain a wide order table inside its own scroll box so the page never
     scrolls horizontally on a narrow phone. */
  .orders .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .orders table { width: 100%; min-width: 22rem; }
  .orders th, .orders td { padding: 0.7rem 0.6rem; vertical-align: baseline; }
  .orders td.date {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
  .orders td.agent {
    color: var(--agent-color, var(--ink));
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .orders td.agent a {
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    display: inline-block;
    padding: 0.15rem 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .orders td.agent a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .orders td.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; }
  .orders tr.rejected td { color: var(--ink-muted); }

  /* Bordered colour-text pills — AA in both light and dark (filled white-on-tint
     fails contrast when --pos/--neg lighten in dark mode). */
  .pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border: 1px solid currentColor;
    border-radius: var(--r-sm, 3px);
    white-space: nowrap;
  }
  .pill.buy, .pill.filled { color: var(--pos); }
  .pill.sell, .pill.rejected { color: var(--neg); }
  .pill.pending { color: var(--ink-muted); }

  .back { margin-top: var(--sp-8, 3rem); }

  @media (max-width: 40rem) {
    .stats dl { grid-template-columns: 1fr; }
    .stats dl div { border-right: 0; border-bottom: 1px solid var(--rule); }
    .stats dl div:last-child { border-bottom: 0; }
  }
  @media (max-width: 26rem) {
    .orders th, .orders td { padding: 0.45rem 0.35rem; font-size: var(--fs-xs); }
  }
</style>
