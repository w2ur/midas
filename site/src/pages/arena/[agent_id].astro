---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortfolioTable from "@/components/PortfolioTable.astro";
import TradeCard from "@/components/TradeCard.astro";
import BaselineChart from "@/components/BaselineChart.astro";
import { TRADING_AGENTS, type AgentId, getAgent, getAgentMonogram } from "@/lib/roster";
import { loadLatest, listDates as listOutputDates } from "@/lib/output";
import { loadMemory, renderMemoryHtml } from "@/lib/memory";
import { loadAllOrders } from "@/lib/orders";
import { loadBenchmark, loadCoinFlip, returnPct, AGENT_BENCHMARK_LABELS } from "@/lib/baselines";
import { loadPortfolioSnapshots } from "@/lib/portfolios";
import { currentDayNumber } from "@/lib/session";

export function getStaticPaths() {
  return TRADING_AGENTS.map((a) => ({ params: { agent_id: a.id } }));
}

const { agent_id } = Astro.params as { agent_id: AgentId };
const agent = getAgent(agent_id);
const bundle = loadLatest();
const daily = bundle.agents[agent.id];
if (!daily) throw new Error(`Agent ${agent.id} missing from latest bundle`);

// Bundle invariant: every agent appears every day. `commentary === null`
// means the agent didn't run this session (weekend cadence, etc.) — render
// a "Holding" banner with the date of their last activity.
const didRunToday = daily.commentary !== null;

const outputDates = listOutputDates();
const daysLive = outputDates.length;

const pnlRow = bundle.leaderboard.find((r) => r.agent === agent.id);
const pnl = pnlRow?.return_pct ?? 0;
const pnlCls = pnl > 0 ? "pos" : pnl < 0 ? "neg" : "";
const pnlStr = (pnl > 0 ? "+" : "") + pnl.toFixed(2) + "%";

const benchSeries = loadBenchmark(agent.id);
const coinSeries = loadCoinFlip(agent.id);
const agentSeries = loadPortfolioSnapshots(agent.id);
const benchReturnPct = returnPct(benchSeries);
const coinReturnPct = returnPct(coinSeries);

// Delta in percentage points = agent return - reference return
const vsBench = benchReturnPct !== null ? pnl - benchReturnPct : null;
const vsCoin = coinReturnPct !== null ? pnl - coinReturnPct : null;

function fmtDelta(v: number | null): string {
  if (v === null) return "—";
  const s = v >= 0 ? "+" : "";
  return `${s}${v.toFixed(2)} pts`;
}
function deltaCls(v: number | null): string {
  if (v === null) return "";
  return v > 0 ? "pos" : v < 0 ? "neg" : "";
}

const journalMd = loadMemory(agent.id);
const journalHtml = renderMemoryHtml(journalMd);

const agentOrders = loadAllOrders()
  .filter((o) => o.agent_id === agent.id)
  .sort((a, b) => (a.date === b.date ? b.order_id.localeCompare(a.order_id) : b.date.localeCompare(a.date)));
const recentOrdersByDate = new Map<string, typeof agentOrders>();
for (const o of agentOrders) {
  const list = recentOrdersByDate.get(o.date) ?? [];
  list.push(o);
  recentOrdersByDate.set(o.date, list);
}
const recentDateGroups = Array.from(recentOrdersByDate.entries()).slice(0, 5);

// Last date this agent actually traded (any fill or attempt).
const lastActiveDate = agentOrders.length > 0 ? agentOrders[0].date : null;

const sessionStamp = String(currentDayNumber()).padStart(3, "0");
const monogram = getAgentMonogram(agent.id);
const startCcy = agent.base_currency === "USD" ? "USD" : "EUR";
const benchLabel = AGENT_BENCHMARK_LABELS[agent.id] ?? "benchmark";
---
<BaseLayout title={agent.display_name} current="arena" description={`${agent.display_name} — ${agent.archetype}`}>
  <article class="page dossier" data-agent={agent.id}>
    <header class="dossier-head">
      <p class="session-stamp">
        <span class="mk" aria-hidden="true"></span>
        DOSSIER · SESSION {sessionStamp} · {agent.base_currency.toUpperCase()} BASE
      </p>
      <div class="namerow">
        <span class="monogram" aria-hidden="true">{monogram}</span>
        <h1>{agent.display_name}</h1>
      </div>
      <p class="tagline">{agent.archetype}.</p>
      <p class="meta">{agent.universe_summary}</p>

      <dl class="statrow">
        <div class="statcell">
          <dt>Return (EUR)</dt>
          <dd class={`val phosphor ${pnlCls}`}>{pnlStr}</dd>
        </div>
        <div class="statcell">
          <dt>Starting capital</dt>
          <dd class="val"><span class="unit">{startCcy}</span> 10,000</dd>
        </div>
        <div class="statcell">
          <dt>Days live</dt>
          <dd class="val">{daysLive}</dd>
        </div>
        <div class="statcell">
          <dt>vs {benchLabel}</dt>
          <dd class={`val ${deltaCls(vsBench)}`}>{fmtDelta(vsBench)}</dd>
        </div>
        <div class="statcell">
          <dt>vs coin flip</dt>
          <dd class={`val ${deltaCls(vsCoin)}`}>{fmtDelta(vsCoin)}</dd>
        </div>
      </dl>
    </header>

    <section class="dsec perf-section">
      <p class="eyebrow">Performance</p>
      <h2>Return since Day 1</h2>
      <BaselineChart
        agent={agentSeries}
        benchmark={benchSeries}
        coinflip={coinSeries}
        benchmarkLabel={AGENT_BENCHMARK_LABELS[agent.id] ?? "Benchmark"}
      />
    </section>

    <section class="dsec holdings">
      <h2>Portfolio</h2>
      {!didRunToday && (
        <p class="holding-banner">
          Holding · no session today{lastActiveDate ? ` · last activity ${lastActiveDate}` : ""}
        </p>
      )}
      <PortfolioTable portfolio={daily.portfolio} asOf={bundle.date} />
    </section>

    {recentDateGroups.length > 0 && (
      <section class="dsec order-book">
        <p class="eyebrow">Recent trades</p>
        <h2>Order book</h2>
        {recentDateGroups.map(([date, orders]) => (
          <div class="trade-group">
            <p class="date-head">{date}</p>
            <TradeCard orders={orders} />
          </div>
        ))}
      </section>
    )}

    <section class="dsec journal">
      <h2>Journal</h2>
      <p class="note">First-person. Biased on purpose. Rewritten each session.</p>
      <div class="prose" set:html={journalHtml}></div>
    </section>

    <p class="back"><a href="/arena">← All agents</a></p>
  </article>
</BaseLayout>
<style>
  /* ── Header ── */
  .dossier-head { padding-bottom: var(--sp-2); }
  .session-stamp {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-4);
  }
  .session-stamp .mk {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--agent-color, var(--accent));
    flex: none;
  }
  .namerow { display: flex; align-items: center; gap: var(--sp-4); margin: 0 0 var(--sp-4); }
  .monogram {
    width: 60px;
    height: 60px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elev2);
    color: var(--agent-color, var(--accent));
    border: 1px solid var(--agent-color, var(--rule));
    border-radius: var(--r-lg);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--fs-xl);
    line-height: 1;
  }
  .namerow h1 { margin: 0; }
  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-lg);
    color: var(--ink-muted);
    margin: 0 0 var(--sp-3);
    max-width: var(--measure-wide);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  /* ── Stat row — flush, ruled (gap-as-divider survives wrapping) ── */
  .statrow {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    margin: var(--sp-6) 0 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .statcell { background: var(--bg-elev); padding: var(--sp-4) var(--sp-5); }
  .statcell dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-2);
  }
  .statcell .val {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
  }
  .statcell .val.pos { color: var(--pos); }
  .statcell .val.neg { color: var(--neg); }
  .statcell .val .unit { font-size: 0.6em; color: var(--ink-faint); }
  @media (max-width: 60rem) { .statrow { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 30rem) { .statrow { grid-template-columns: 1fr; } }

  /* ── Sections ── */
  .dsec {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--rule);
  }
  .dsec h2 { margin-top: 0; }
  .dsec .eyebrow + h2 { margin-top: var(--sp-1); }

  .holding-banner {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--ink-muted);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--r-sm);
    padding: var(--sp-3) var(--sp-4);
    margin: 0 0 var(--sp-5);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Order book ── */
  .order-book .trade-group { margin-top: var(--sp-5); }
  .order-book .date-head {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-3);
  }

  /* ── Journal — the machine's voice: GROTESK, not serif ── */
  .journal .note {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-5);
  }
  .prose {
    font-family: var(--font-display);
    max-width: var(--measure);
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--ink);
  }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(p:first-child) { font-weight: 600; font-size: var(--fs-md); color: var(--ink); }
  .prose :global(ul) { list-style: none; padding: 0; margin: var(--sp-5) 0 0; }
  .prose :global(li) {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: var(--sp-4);
    color: var(--ink-muted);
  }
  .prose :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--agent-color, var(--accent));
  }
  .prose :global(h2), .prose :global(h3) { font-family: var(--font-display); margin-top: var(--sp-5); }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9em; color: var(--ink); }
  .prose :global(blockquote) {
    border-left: 2px solid var(--agent-color, var(--accent));
    padding-left: var(--sp-4);
    margin: var(--sp-5) 0;
    color: var(--ink-muted);
  }

  .back { margin-top: var(--sp-7); }
  .back a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
</style>
