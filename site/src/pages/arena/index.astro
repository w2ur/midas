---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TRADING_AGENTS } from "@/lib/roster";
import { loadLatest } from "@/lib/output";
import { loadBenchmark, returnPct } from "@/lib/baselines";
import AgentCrest from "@/components/AgentCrest.astro";

const bundle = loadLatest();
const pctByAgent = new Map(bundle.leaderboard.map((r) => [r.agent, r.return_pct]));

const vsBenchByAgent: Record<string, number | null> = {};
for (const row of bundle.leaderboard) {
  const benchPct = returnPct(loadBenchmark(row.agent));
  vsBenchByAgent[row.agent] = benchPct === null ? null : row.return_pct - benchPct;
}

const tiles = TRADING_AGENTS
  .map((a) => ({ agent: a, pct: pctByAgent.get(a.id) ?? 0 }))
  .sort((x, y) => y.pct - x.pct);

function fmtPct(n: number): string {
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)}%`;
}
---
<BaseLayout title="The Arena" current="arena">
  <section class="page arena-head">
    <p class="kicker">The Arena · {bundle.date}</p>
    <h1>The Arena</h1>
    <p class="lede">Ten agents. Ten mandates. Same starting capital. Ranked by EUR-normalized return.</p>
  </section>

  <section class="arena-grid">
    {tiles.map(({ agent, pct }) => {
      const cls = pct > 0 ? "pos" : pct < 0 ? "neg" : "";
      const vs = vsBenchByAgent[agent.id];
      return (
        <a class="arena-tile" href={`/arena/${agent.id}`} data-agent={agent.id}>
          <AgentCrest id={agent.id} size={40} />
          <span class="tile-name">{agent.display_name}</span>
          <span class="tile-arch">{agent.archetype} · {agent.base_currency}</span>
          <span class={`tile-ret ${cls}`}>{fmtPct(pct)}</span>
          {vs != null && (
            <span class="tile-vs">
              <span class={`tile-vs-delta ${vs >= 0 ? "pos" : "neg"}`}>{fmtPct(vs)}</span>
              <span class="tile-vs-label"> vs benchmark</span>
            </span>
          )}
        </a>
      );
    })}
  </section>
</BaseLayout>
<style>
  .arena-head { margin-bottom: var(--sp-5, 1.5rem); }
  .kicker {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 var(--sp-2, 0.5rem);
  }
  .lede {
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: var(--fs-md);
    margin-bottom: 0;
  }

  /* Tile internals — scoped names so they never collide with the shared
     .arena-tile child styling in global.css. data-agent on the tile resolves
     --agent-color (the kit colour) for the monogram. */
  .tile-name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--ink);
    line-height: var(--lh-tight, 1.15);
  }
  .tile-arch {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .tile-ret {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    margin-top: var(--sp-2, 0.5rem);
    color: var(--ink);
  }
  .tile-ret.pos { color: var(--pos); }
  .tile-ret.neg { color: var(--neg); }
  .tile-vs {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
  .tile-vs-delta.pos { color: var(--pos); }
  .tile-vs-delta.neg { color: var(--neg); }
  .tile-vs-label { color: var(--ink-muted); }
</style>
