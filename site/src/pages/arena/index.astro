---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TRADING_AGENTS } from "@/lib/roster";
import { loadLatest } from "@/lib/output";
import AgentCrest from "@/components/AgentCrest.astro";
import CompareChart from "@/components/CompareChart.astro";
import { loadCurrentLeaderboard } from "@/lib/leaderboard";
import { loadPortfolioSnapshots } from "@/lib/portfolios";
import { MANAGER, loadManagerSnapshots, snapshotReturnPct } from "@/lib/manager";
import { getLedgerNote } from "@/lib/ledger-notes";
import { AGENT_BENCHMARK_LABELS } from "@/lib/baselines";
import { boardLayout } from "@/lib/board-sort";

const bundle = loadLatest();
// Prefer the live artifact: since 2026-08-14 its rows carry the
// benchmark-relative figures the tiles rank on (bundle fallback covers a
// fresh fork with no current.json yet).
const boardRows = loadCurrentLeaderboard()?.rows ?? bundle.leaderboard;
const pctByAgent = new Map(boardRows.map((r) => [r.agent, r.return_pct]));
const rowByAgent = new Map(boardRows.map((r) => [r.agent, r]));

// Engine-computed, book-currency excess vs each agent's own benchmark — the
// site does no FX arithmetic on purpose. Null for rows written before the
// field existed or when an agent has no baseline series.
const vsBenchByAgent: Record<string, number | null> = {};
for (const row of boardRows) {
  vsBenchByAgent[row.agent] = row.vs_benchmark_pp ?? null;
}

// Same rule as the leaderboard table: the tiles are ORDERED by the
// benchmark-relative figure, so that figure has to be the one they lead
// with. Showing the EUR return large above a "vs benchmark" whisper put the
// worst-looking number on the first tile. Data-driven, so a fork whose
// artifact predates the metric keeps the return-led tile it was published
// with rather than showing an empty headline.
const { leadIsExcess } = boardLayout(boardRows, true);

// Rank on the benchmark-relative figure, null-last (a missing baseline is an
// absence of information, never a best or worst score); raw EUR return
// breaks ties and orders the null tail — mirroring engine and board-sort.
const tiles = TRADING_AGENTS
  .map((a) => ({ agent: a, pct: pctByAgent.get(a.id) ?? 0, vs: vsBenchByAgent[a.id] ?? null }))
  .sort((x, y) => {
    if (x.vs === null && y.vs === null) return y.pct - x.pct;
    if (x.vs === null) return 1;
    if (y.vs === null) return -1;
    return y.vs - x.vs !== 0 ? y.vs - x.vs : y.pct - x.pct;
  });

// Comparison series. Rank is the tile order (board rank), which drives the
// chart's default top-vs-bottom selection.
const compareSeries = tiles.map(({ agent }, i) => ({
  agent,
  rank: i + 1,
  points: loadPortfolioSnapshots(agent.id),
}));

function fmtPct(n: number): string {
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)}%`;
}

// A benchmark-relative figure is a difference of two percentages, so its unit
// is percentage POINTS. It was rendered through fmtPct as "+6.62%", which
// names a different quantity than the one published.
function fmtPP(n: number): string {
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)} pp`;
}

// The Manager (allocator) is off the ranked leaderboard by design — different
// capital, start date, and mandate. Surfaced below the grid as an unranked
// reference card, never scored against the arena.
const managerRet = snapshotReturnPct(loadManagerSnapshots());
---
<BaseLayout
  title="The Arena"
  current="arena"
  description="Ten AI agents run real-market paper simulations from the same starting capital, ranked by return versus each agent's own passive benchmark. Plus the Manager, an allocator kept off the ranked board."
>
  <section class="page arena-head">
    <p class="kicker">The Arena · {bundle.date}</p>
    <h1>The Arena</h1>
    <p class="lede">Ten agents. Ten mandates. Same starting capital. Ranked by return vs each agent's own benchmark — raw EUR return shown alongside.</p>
  </section>

  <section class="page compare-section">
    <CompareChart series={compareSeries} />
  </section>

  <section class="arena-grid">
    {tiles.map(({ agent, pct }) => {
      const vs = vsBenchByAgent[agent.id];
      const row = rowByAgent.get(agent.id);
      const local = row?.return_local_pct ?? null;
      const ccy = row?.currency ?? null;
      const bench = AGENT_BENCHMARK_LABELS[agent.id] ?? null;
      const ledgerNote = getLedgerNote(agent.id);
      // The tile leads with whatever it is ranked by. A measured row leads on
      // excess; one with no baseline series ranks null-last and falls back to
      // its EUR return rather than heading a tile with "—".
      const onExcess = leadIsExcess && vs != null;
      const leadVal = onExcess ? (vs as number) : pct;
      const cls = leadVal > 0 ? "pos" : leadVal < 0 ? "neg" : "";
      // The book-currency return is only worth a second figure when it
      // differs from the EUR one — i.e. on a book denominated outside EUR.
      const showLocal = onExcess && local != null && ccy != null && ccy !== "EUR";
      return (
        <a class="arena-tile" href={`/arena/${agent.id}`} data-agent={agent.id}>
          <AgentCrest id={agent.id} size={40} />
          <span class="tile-name">{agent.display_name}</span>
          <span class="tile-arch">{agent.archetype} · {agent.base_currency}</span>
          <span class={`tile-ret ${cls}`}>
            {onExcess ? fmtPP(leadVal) : fmtPct(leadVal)}
            {ledgerNote && (
              <span class="tile-flag" title={`${ledgerNote.label} — see dossier`}>†</span>
            )}
          </span>
          {onExcess && (
            <span class="tile-vs">
              <span class="tile-vs-label">vs {bench ?? "benchmark"}</span>
            </span>
          )}
          {onExcess && (
            <span class="tile-sub">
              {`${fmtPct(pct)} EUR`}{showLocal && ` · ${fmtPct(local as number)} ${ccy}`}
            </span>
          )}
        </a>
      );
    })}
  </section>

  <section class="unranked">
    <p class="unranked-eyebrow">Off the leaderboard · allocator</p>
    <a class="unranked-card" href={`/arena/${MANAGER.id}`} data-agent={MANAGER.id}>
      <AgentCrest id={MANAGER.id} size={44} />
      <div class="unranked-body">
        <span class="unranked-name">{MANAGER.display_name}</span>
        <span class="unranked-arch">{MANAGER.archetype}.</span>
        <span class="unranked-meta">
          EUR {MANAGER.initial_capital.toLocaleString("en-GB")} book · since {MANAGER.inception} ·
          not comparable to the ranked agents
        </span>
      </div>
      <span class="unranked-ret">
        {managerRet !== null && (
          <span class={managerRet > 0 ? "pos" : managerRet < 0 ? "neg" : ""}>{fmtPct(managerRet)}</span>
        )}
        <span class="unranked-open">Open dossier →</span>
      </span>
    </a>
  </section>
</BaseLayout>
<style>
  .arena-head { margin-bottom: var(--sp-5, 1.5rem); }
  .kicker {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 var(--sp-2, 0.5rem);
  }
  .lede {
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: var(--fs-md);
    margin-bottom: 0;
  }

  /* Tile internals — scoped names so they never collide with the shared
     .arena-tile child styling in global.css. data-agent on the tile resolves
     --agent-color (the kit colour) for the crest. */
  .tile-name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--ink);
    line-height: var(--lh-tight, 1.15);
  }
  .tile-arch {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .tile-ret {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    margin-top: var(--sp-2, 0.5rem);
    color: var(--ink);
  }
  .tile-ret.pos { color: var(--pos); }
  .tile-ret.neg { color: var(--neg); }
  .tile-flag {
    font-family: var(--font-mono);
    font-size: 0.7em;
    color: var(--ink-faint);
    margin-left: 0.15em;
    vertical-align: super;
  }
  .tile-vs {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
  .tile-vs-label { color: var(--ink-muted); }
  /* Raw EUR return (and the book-currency one where they differ), demoted
     beneath the ranked figure rather than removed. */
  .tile-sub {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-faint, var(--ink-muted));
    margin-top: 0.15rem;
  }

  /* Unranked reference card — clearly separated from the ranked grid. */
  .unranked { margin-top: var(--sp-7); padding-top: var(--sp-6); border-top: 1px solid var(--rule); }
  .unranked-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--sp-4);
  }
  .unranked-card {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-5);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--r-md);
    background: var(--bg-elev);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .unranked-card:hover { border-color: var(--agent-color, var(--accent)); }
  .unranked-body { display: flex; flex-direction: column; gap: var(--sp-2); min-width: 0; }
  .unranked-name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--ink);
    line-height: var(--lh-tight, 1.15);
  }
  .unranked-arch { color: var(--ink-muted); font-size: var(--fs-sm); }
  .unranked-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .unranked-ret {
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sp-2);
    flex: none;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    color: var(--ink);
  }
  .unranked-ret .pos { color: var(--pos); }
  .unranked-ret .neg { color: var(--neg); }
  .unranked-open {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--agent-color, var(--accent));
    white-space: nowrap;
  }
  @media (max-width: 34rem) {
    .unranked-card { flex-wrap: wrap; }
    .unranked-ret { margin-left: 0; align-items: flex-start; flex-direction: row; align-items: baseline; }
  }
</style>
