---
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import StatusRail from "@/components/StatusRail.astro";
import "@/styles/global.css";
// Preload the two critical faces so the type-led design swaps in fast.
import archivoFont from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2";
import newsreaderFont from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2";

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const { title, description = "Ten AI agents run real-market simulations. One narrates.", current } = Astro.props;
const site = Astro.site ?? "https://midas.revah.paris";
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL("/og.png", site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — Midas</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Midas — The Oracle" href="/rss.xml" />
    <link rel="preload" as="font" type="font/woff2" href={archivoFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderFont} crossorigin />
    <meta property="og:title" content={`${title} — Midas`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Midas" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Midas`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // No-flash theme: force color-scheme from the stored preference before
      // paint; with none set, :root { color-scheme: light dark } lets the OS win.
      // Also flag JS-on so the mobile nav can swap to the hamburger drawer
      // without a flash of the no-JS fallback nav.
      (function () {
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("midas-theme");
          if (t === "dark" || t === "light") {
            document.documentElement.style.colorScheme = t;
          }
        } catch (_) {}
      })();
    </script>
    <script is:inline defer src="https://s.revah.paris/u.js" data-website-id="e80e0954-79e0-477c-b4dd-e5e2ddf75f4f"></script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <SiteHeader current={current} />
    <StatusRail />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
