---
// The front page's exhibit: one real decision, in the agent's own words,
// beside the promise it proves. Picked by lib/latest-fill's latestDecision
// (the newest trader record of any status: filled, refused or pending). The rationale is the agent's verbatim text, clamped to two lines
// with the rest one click away
// — a machine voice, so Archivo, never the Oracle's serif. No amber: the card
// is coloured by the agent's kit, and amber keeps its one meaning.
import AgentCrest from "@/components/AgentCrest.astro";
import type { Order } from "@/lib/orders";
import { tickerSlug } from "@/lib/orders";
import { decisionStamp, pendingCondition, rawRecordUrl, statusLine } from "@/lib/latest-fill";
import { formatPrice, formatShares } from "@/lib/format";
import { getAgent, type AgentId } from "@/lib/roster";
import { isCrestId } from "@/lib/crests";

interface Props { order: Order & { agent_id: AgentId } }
const { order: o } = Astro.props;

const name = getAgent(o.agent_id).display_name;
const status = statusLine(o);

const when = decisionStamp(o);

const filled = o.status === "filled";
const condition = pendingCondition(o);
// The record's own leading fields, in the file's key order and its
// `json.dumps` spacing — an excerpt of the outbox line the link opens, not a
// summary built for the card. Fill data lives in the inbox, not here.
const raw = `{"order_id": ${JSON.stringify(o.order_id)}, "agent_id": ${JSON.stringify(o.agent_id)}, ` +
  `"action": ${JSON.stringify(o.action)}, "ticker": ${JSON.stringify(o.ticker)}, "shares": ${pyFloat(o.shares)}, …}`;

// The outbox is written by Python, which prints a float share count as `1.0`.
function pyFloat(n: number): string {
  return Number.isInteger(n) ? `${n}.0` : String(n);
}
---
<aside class="latest-fill" data-agent={o.agent_id} aria-labelledby="lf-label">
  <header class="lf-head">
    <h2 id="lf-label" class="lf-label">Latest decision</h2>
    <time class="lf-when" datetime={when.datetime}>{when.text}</time>
  </header>

  <p class="lf-who">
    {isCrestId(o.agent_id) && <AgentCrest id={o.agent_id} size={24} />}
    <a class="lf-name" href={`/arena/${o.agent_id}`}>{name}</a>
  </p>

  <p class="lf-trade">
    <span class={`lf-side ${o.action.toLowerCase()}`}>{o.action}</span>
    <a class="lf-tick" href={`/ticker/${tickerSlug(o.ticker)}`}>{o.ticker}</a>
    <span class="lf-qty">{formatShares(o.shares)} sh{filled && <> @ {formatPrice(o.fill_price, o.fill_currency)}</>}{condition && <> · {condition}</>}</span>
  </p>
  <p class="lf-status">
    {status.label}{status.code && <>: <code>{status.code}</code></>}{status.writtenOn && <> · order written {status.writtenOn}</>}
  </p>

  <p class="lf-why">{o.reasoning}</p>
  <details class="lf-more">
    <summary><span class="lf-show">Full rationale</span><span class="lf-hide">Hide rationale</span></summary>
    <p class="lf-full">{o.reasoning}</p>
  </details>

  <a class="lf-raw" href={rawRecordUrl(o)}>
    <span class="lf-raw-label">Raw order record</span>
    <code>{raw}</code>
  </a>
</aside>

<script is:inline>
  // The toggle is always in the markup and server-rendered visible; it is
  // hidden only when the paragraph, measured with its clamp lifted, is no taller than the clamped box. One script,
  // placed right after the card so the first measurement runs before the next
  // paint (a deferred module would shrink the hero after first paint), then
  // re-run once fonts load and on resize, at most once per frame. Measured
  // while closed (an open card hides the clamped copy). Without JS the toggle
  // stays visible, a harmless no-op.
  (function () {
    var card = document.currentScript.previousElementSibling;
    if (!card) return;
    var more = card.querySelector(".lf-more");
    var why = card.querySelector(".lf-why");
    if (!more || !why) return;
    function fit() {
      if (more.open) return;
      // Compare the clamped height with the text's own height, read with the
      // clamp lifted, so the answer does not depend on how the browser lays
      // out lines past a line-clamp. Same script turn: nothing paints between.
      var clamped = why.clientHeight;
      why.classList.add("lf-measure");
      var full = why.scrollHeight;
      why.classList.remove("lf-measure");
      if (full <= clamped) card.setAttribute("data-fits", "");
      else card.removeAttribute("data-fits");
    }
    fit();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    // fit() is skipped while open, so a resize in that state leaves data-fits
    // stale: measure again when the card closes.
    more.addEventListener("toggle", function () { if (!more.open) fit(); });
    var queued = false;
    window.addEventListener("resize", function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () { queued = false; fit(); });
    });
  })();
</script>

<style>
  .latest-fill {
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    box-shadow: inset 3px 0 0 var(--agent-color), var(--shadow-1);
    padding: var(--sp-5) var(--sp-5) var(--sp-4) calc(var(--sp-5) + 3px);
    min-width: 0;
  }
  .lf-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-1) var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .lf-label {
    margin: 0;
    font-size: var(--fs-base);
    font-weight: 700;
    letter-spacing: 0;
  }
  .lf-when {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
  .lf-who {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 0 0 var(--sp-2);
  }
  .lf-name {
    color: var(--agent-color);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    text-decoration: none;
  }
  .lf-name:hover { color: var(--agent-color); text-decoration: underline; text-underline-offset: 4px; }
  .lf-trade {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-2);
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-base);
    color: var(--ink);
  }
  .lf-side {
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    padding: 0.05rem 0.45rem;
    border-radius: var(--r-sm);
    color: var(--accent-ink);
  }
  .lf-side.buy { background: var(--pos); }
  .lf-side.sell { background: var(--neg); }
  .lf-tick { color: var(--ink); font-weight: 500; }
  .lf-tick:hover { color: var(--ink); text-decoration-thickness: 2px; }
  .lf-qty { color: var(--ink-muted); }
  .lf-status {
    margin: var(--sp-1) 0 var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
  .lf-why {
    margin: 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    line-height: 1.5;
    color: var(--ink);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  /* Applied for a moment by the script to read the text's full height. */
  .lf-why.lf-measure {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: none;
  }
  /* The full text lives inside <details>, so the toggle works on its own; the
     clamped copy is hidden while it is open. A browser without :has() shows
     both, which still reads in full. */
  .latest-fill:has(.lf-more[open]) .lf-why { display: none; }
  .latest-fill[data-fits] .lf-more { display: none; }
  .lf-more { margin: var(--sp-2) 0 0; }
  .lf-more[open] { margin-top: 0; }
  .lf-full {
    margin: 0;
    overflow-wrap: anywhere;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    line-height: 1.5;
    color: var(--ink);
  }
  .lf-more[open] { display: flex; flex-direction: column-reverse; }
  .lf-more summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    list-style: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .lf-more summary::-webkit-details-marker { display: none; }
  .lf-more[open] summary { text-decoration-thickness: 2px; }
  .lf-hide, .lf-more[open] .lf-show { display: none; }
  .lf-more[open] .lf-hide { display: inline; }
  .lf-raw {
    display: block;
    margin-top: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--bg-elev2);
    border-radius: var(--r-sm);
    color: var(--ink-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }
  .lf-raw:hover { color: var(--ink); }
  .lf-raw-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    margin-bottom: var(--sp-1);
  }
  .lf-raw code { overflow-wrap: anywhere; font: inherit; }
</style>
