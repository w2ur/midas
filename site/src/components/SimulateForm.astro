---
const universeOptions = [
  { value: "sp500", label: "S&P 500" },
  { value: "dow30", label: "Dow 30" },
  { value: "nasdaq100", label: "NASDAQ 100" },
  { value: "cac40", label: "CAC 40" },
  { value: "dax", label: "DAX" },
  { value: "ftse100", label: "FTSE 100" },
  { value: "stoxx-600", label: "STOXX 600" },
  { value: "crypto-top20-eur", label: "Crypto top 20 (EUR)" },
  { value: "crypto-top20", label: "Crypto top 20 (USD)" },
  { value: "forex-majors", label: "Forex majors" },
  { value: "metals-commodities", label: "Metals + commodities" },
  { value: "bearish-etfs", label: "Bearish ETFs" },
  { value: "bearish-etfs-ucits", label: "Bearish ETFs (UCITS)" },
  { value: "commodities-eur", label: "Commodities (EUR)" },
  { value: "single-voo", label: "VOO only" },
  { value: "classic-60-40", label: "Classic 60/40" },
];

const selectorOptions = [
  { value: "random", label: "Random" },
  { value: "golden-cross", label: "Golden cross" },
  { value: "rsi-oversold", label: "RSI oversold" },
  { value: "dip-entry", label: "Dip entry" },
  { value: "fear-greed", label: "Fear and greed" },
  { value: "data-follow", label: "Data follow" },
  { value: "buy-and-hold", label: "Buy and hold" },
  { value: "earnings-beat", label: "Earnings beat" },
  { value: "sector-cycle", label: "Sector cycle" },
];

const managerOptions = [
  { value: "equal-weight", label: "Equal weight" },
  { value: "grid-conservative", label: "Grid (conservative)" },
  { value: "grid-aggressive", label: "Grid (aggressive)" },
  { value: "trailing-stop", label: "Trailing stop" },
  { value: "scaled-exit", label: "Scaled exit" },
  { value: "time-boxed", label: "Time boxed" },
  { value: "rebalance-monthly", label: "Monthly rebalance" },
  { value: "volatility-sized", label: "Volatility sized" },
  { value: "fixed-60-40", label: "Fixed 60/40" },
];

type Slot = "a" | "b";
const slotDefaults: Record<Slot, Record<string, string>> = {
  a: { universe: "classic-60-40", selector: "buy-and-hold", manager: "fixed-60-40" },
  b: { universe: "classic-60-40", selector: "golden-cross", manager: "trailing-stop" },
};
---

<form id="simulate-form" class="simulate-form">
  {(["a", "b"] as Slot[]).map((slot) => (
    <fieldset class="strategy-slot" data-slot={slot} hidden={slot === "b"}>
      <legend class="slot-header">
        <span>Strategy {slot.toUpperCase()}</span>
        {slot === "b" && (
          <button type="button" class="slot-remove" data-action="remove-b">× Remove</button>
        )}
      </legend>
      <div class="grid">
        <label class="ctl">
          <span>Universe</span>
          <select name={`universe_${slot}`} required>
            {universeOptions.map((o) => (
              <option value={o.value} selected={o.value === slotDefaults[slot].universe}>{o.label}</option>
            ))}
          </select>
        </label>

        <label class="ctl">
          <span>Selector</span>
          <select name={`selector_${slot}`} required>
            {selectorOptions.map((o) => (
              <option value={o.value} selected={o.value === slotDefaults[slot].selector}>{o.label}</option>
            ))}
          </select>
        </label>

        <label class="ctl">
          <span>Manager</span>
          <select name={`manager_${slot}`} required>
            {managerOptions.map((o) => (
              <option value={o.value} selected={o.value === slotDefaults[slot].manager}>{o.label}</option>
            ))}
          </select>
        </label>

        <label class="ctl">
          <span>Start</span>
          <input type="date" name={`start_date_${slot}`} value="2018-01-01" required />
        </label>

        <label class="ctl">
          <span>End</span>
          <input type="date" name={`end_date_${slot}`} value="2024-12-31" required />
        </label>

        <label class="ctl">
          <span>Capital</span>
          <input type="number" name={`capital_${slot}`} min="100" value="10000" required />
        </label>

        <label class="ctl">
          <span>Currency</span>
          <select name={`currency_${slot}`}>
            <option value="EUR">EUR</option>
            <option value="USD">USD</option>
          </select>
        </label>

        <label class="ctl">
          <span>Max positions</span>
          <input type="number" name={`max_positions_${slot}`} min="1" max="100" value="20" required />
        </label>

        <label class="ctl">
          <span>Max position %</span>
          <input type="number" name={`max_position_pct_${slot}`} min="0.1" max="100" step="0.1" value="100" required />
        </label>

        <label class="ctl">
          <span>Min hold days</span>
          <input type="number" name={`min_hold_days_${slot}`} min="0" max="365" value="0" required />
        </label>
      </div>
    </fieldset>
  ))}

  <button type="button" id="add-strategy-b" class="add-strategy">+ Add Strategy B to compare</button>

  <div class="actions">
    <button type="submit">Run backtest</button>
    <p class="hint" id="simulate-hint" hidden>
      Warming up the backtester — first run takes a few seconds&hellip;
    </p>
  </div>
</form>

<style>
  .simulate-form { margin: 1.5rem 0; }
  .simulate-form .strategy-slot {
    border: 1px solid var(--rule);
    padding: 1rem 1.25rem 1.25rem;
    margin: 1.25rem 0;
  }
  .simulate-form .slot-header {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: 0 .5rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
  }
  .simulate-form .strategy-slot[data-slot="a"] .slot-header { color: #0a6; }
  .simulate-form .strategy-slot[data-slot="b"] .slot-header { color: #36c; }
  .simulate-form .slot-remove {
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-muted);
    font: inherit;
    font-size: var(--fs-xs);
    padding: .15rem .5rem;
    cursor: pointer;
  }
  .simulate-form .slot-remove:hover { border-color: var(--ink); color: var(--ink); }
  .simulate-form .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: .75rem 1rem;
    margin-top: 1rem;
  }
  .simulate-form .ctl {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    font-size: var(--fs-xs);
  }
  .simulate-form .ctl > span {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .simulate-form select,
  .simulate-form input {
    font: inherit;
    padding: .35rem .5rem;
    border: 1px solid var(--rule);
    background: var(--bg);
    color: var(--ink);
  }
  .simulate-form select:focus,
  .simulate-form input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .simulate-form .add-strategy {
    background: transparent;
    border: 1px dashed var(--rule);
    color: var(--ink-muted);
    font: inherit;
    font-weight: 600;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: .5rem 1rem;
    cursor: pointer;
    width: 100%;
    margin: .5rem 0 1rem;
  }
  .simulate-form .add-strategy:hover { border-color: var(--ink); color: var(--ink); }
  .simulate-form .add-strategy[hidden] { display: none; }
  .simulate-form .actions {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .simulate-form button[type="submit"] {
    padding: .5rem 1.25rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--bg);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--fs-xs);
  }
  .simulate-form button[type="submit"]:hover { background: var(--accent); border-color: var(--accent); }
  .simulate-form .hint { margin: 0; color: var(--ink-muted); font-size: var(--fs-xs); }
</style>

<script>
  import {
    decodeConfig,
    encodeConfig,
    type SimulateConfig,
  } from "../lib/simulate-config";
  import {
    pingBacktester,
    runBacktest,
    type RunResponse,
  } from "../lib/simulate-api";
  import { EXAMPLE_RESULT } from "../lib/simulate-example";

  type Slot = "a" | "b";

  declare global {
    interface Window {
      __renderSimulateCharts?: (results: RunResponse[]) => void;
    }
  }

  function getForm(): HTMLFormElement {
    return document.getElementById("simulate-form") as HTMLFormElement;
  }

  function slotEl(slot: Slot): HTMLFieldSetElement | null {
    return document.querySelector(`fieldset[data-slot="${slot}"]`);
  }

  function isSlotVisible(slot: Slot): boolean {
    const el = slotEl(slot);
    return !!el && !el.hidden;
  }

  function readSlot(slot: Slot): SimulateConfig {
    const form = getForm();
    const data = new FormData(form);
    const get = (name: string) => String(data.get(`${name}_${slot}`));
    const num = (name: string) => Number(data.get(`${name}_${slot}`));
    const cur = data.get(`currency_${slot}`);
    return {
      kind: "signal",
      config: {
        universe: get("universe"),
        selector: get("selector"),
        manager: get("manager"),
        max_positions: num("max_positions"),
        max_position_pct: num("max_position_pct"),
        min_hold_days: num("min_hold_days"),
      },
      start_date: get("start_date"),
      end_date: get("end_date"),
      capital: num("capital"),
      currency: cur === "USD" ? "USD" : "EUR",
    };
  }

  function writeSlot(slot: Slot, config: SimulateConfig): void {
    const form = getForm();
    const set = (name: string, value: string | number) => {
      const el = form.elements.namedItem(`${name}_${slot}`) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = String(value);
    };
    set("universe", config.config.universe);
    set("selector", config.config.selector);
    set("manager", config.config.manager);
    set("max_positions", config.config.max_positions);
    set("max_position_pct", config.config.max_position_pct);
    set("min_hold_days", config.config.min_hold_days);
    set("start_date", config.start_date);
    set("end_date", config.end_date);
    set("capital", config.capital);
    set("currency", config.currency);
  }

  function showSlotB(): void {
    const el = slotEl("b");
    if (el) el.hidden = false;
    const add = document.getElementById("add-strategy-b");
    if (add) add.hidden = true;
  }

  function hideSlotB(): void {
    const el = slotEl("b");
    if (el) el.hidden = true;
    const add = document.getElementById("add-strategy-b");
    if (add) add.hidden = false;
  }

  function visibleSlots(): Slot[] {
    return (["a", "b"] as Slot[]).filter(isSlotVisible);
  }

  function updateUrl(configs: SimulateConfig[]): void {
    const url = new URL(window.location.href);
    url.searchParams.delete("s");
    for (const c of configs) {
      url.searchParams.append("s", encodeConfig(c));
    }
    history.replaceState(null, "", url.toString());
  }

  function strategyLabel(slot: Slot, config: SimulateConfig): string {
    const c = config.config;
    return `Strategy ${slot.toUpperCase()} — ${c.universe} / ${c.selector} / ${c.manager}`;
  }

  function metricsHtml(slot: Slot, config: SimulateConfig, result: RunResponse): string {
    const m = result.metrics;
    const labelClass = slot === "a" ? "label-a" : "label-b";
    return `
      <div class="strategy-block">
        <p class="strategy-label ${labelClass}">${strategyLabel(slot, config)}</p>
        <dl class="simulate-metrics">
          <div><dt>Total return</dt><dd>${m.total_return_pct.toFixed(1)}%</dd></div>
          <div><dt>CAGR</dt><dd>${m.cagr_pct.toFixed(1)}%</dd></div>
          <div><dt>Sharpe</dt><dd>${m.sharpe.toFixed(2)}</dd></div>
          <div><dt>Max drawdown</dt><dd>${m.max_drawdown_pct.toFixed(1)}%</dd></div>
          <div><dt>vs MSCI World</dt><dd>${m.vs_msci_world_pct.toFixed(1)} pp</dd></div>
          <div><dt>vs Coin flip</dt><dd>${m.vs_coin_flip_pct.toFixed(1)} pp</dd></div>
        </dl>
      </div>
    `;
  }

  function errorHtml(slot: Slot, message: string): string {
    return `<p class="error">Strategy ${slot.toUpperCase()} failed: ${message}</p>`;
  }

  function renderResults(
    pairs: Array<{ slot: Slot; config: SimulateConfig; result?: RunResponse; error?: string }>,
  ): void {
    const successes = pairs
      .filter((p) => p.result)
      .map((p) => p.result as RunResponse);
    window.__renderSimulateCharts?.(successes);

    const mount = document.getElementById("result-mount");
    if (!mount) return;
    mount.innerHTML = pairs
      .map((p) =>
        p.result
          ? metricsHtml(p.slot, p.config, p.result)
          : errorHtml(p.slot, p.error ?? "unknown error"),
      )
      .join("");
  }

  function showWarming(): void {
    const hint = document.getElementById("simulate-hint");
    if (hint) hint.hidden = false;
  }

  function hideWarming(): void {
    const hint = document.getElementById("simulate-hint");
    if (hint) hint.hidden = true;
  }

  async function runOne(slot: Slot, config: SimulateConfig) {
    try {
      const result = await runBacktest(config);
      return { slot, config, result };
    } catch (err) {
      return { slot, config, error: (err as Error).message };
    }
  }

  async function handleSubmit(event: SubmitEvent): Promise<void> {
    event.preventDefault();
    const slots = visibleSlots();
    const configs = slots.map((s) => readSlot(s));
    updateUrl(configs);
    showWarming();
    try {
      const pairs = await Promise.all(slots.map((s, i) => runOne(s, configs[i])));
      renderResults(pairs);
    } finally {
      hideWarming();
    }
  }

  function bootstrap(): void {
    const form = getForm();
    if (!form) return;
    form.addEventListener("submit", handleSubmit);

    const addBtn = document.getElementById("add-strategy-b");
    addBtn?.addEventListener("click", showSlotB);

    form.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target?.dataset?.action === "remove-b") {
        hideSlotB();
      }
    });

    const params = new URLSearchParams(window.location.search);
    const encoded = params.getAll("s");
    const decoded = encoded.map(decodeConfig).filter((c): c is SimulateConfig => c !== null);

    if (decoded.length === 0) {
      // No URL state — render the static example as Strategy A.
      window.__renderSimulateCharts?.([EXAMPLE_RESULT]);
      const mount = document.getElementById("result-mount");
      if (mount) {
        const exampleConfig: SimulateConfig = {
          kind: "signal",
          config: {
            universe: "classic-60-40",
            selector: "buy-and-hold",
            manager: "fixed-60-40",
            max_positions: 20,
            max_position_pct: 100,
            min_hold_days: 0,
          },
          start_date: "2018-01-01",
          end_date: "2026-04-25",
          capital: 10000,
          currency: "EUR",
        };
        mount.innerHTML = metricsHtml("a", exampleConfig, EXAMPLE_RESULT);
      }
    } else {
      writeSlot("a", decoded[0]);
      if (decoded[1]) {
        showSlotB();
        writeSlot("b", decoded[1]);
      }
      void Promise.all(
        (decoded.length === 1 ? (["a"] as Slot[]) : (["a", "b"] as Slot[])).map((s, i) =>
          runOne(s, decoded[i]),
        ),
      ).then(renderResults);
    }

    void pingBacktester();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootstrap);
  } else {
    bootstrap();
  }
</script>
