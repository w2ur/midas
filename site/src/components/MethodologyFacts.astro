---
// The experiment in facts, rendered as a strip of cells.
//
// The figures come from lib/facts.ts — the one source both /methodology (all
// six) and the homepage (four, `compact`) read — so the two pages cannot
// disagree on a fill or session count. Every figure is derived from committed
// artifacts at build time.
import { experimentFacts, pickFacts, type FactKey } from "@/lib/facts";

interface Props {
  /** Which facts, in order. Omit for all six. */
  only?: FactKey[];
  /** Tighter cells for the homepage's first screen. */
  compact?: boolean;
  /** Accessible name for the strip. */
  label?: string;
}
const { only, compact = false, label } = Astro.props;
const facts = only ? pickFacts(only) : experimentFacts();
const ariaLabel = label ?? "The experiment in six facts";
---
<section class={`facts ${compact ? "compact" : ""}`.trim()} aria-label={ariaLabel}>
  <dl>
    {facts.map((f) => (
      <div class="fact">
        <dt>{f.label}</dt>
        <dd class="fact-val">{f.value}</dd>
        <dd class="fact-note">{f.note}</dd>
      </div>
    ))}
  </dl>
</section>
<style>
  .facts {
    max-width: var(--measure-wide);
    margin: 0 auto var(--sp-7);
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .fact {
    background: var(--bg-elev);
    padding: var(--sp-4);
    min-width: 0;
  }
  .fact dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .fact-val {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    line-height: 1.1;
  }
  .fact-note {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--ink-muted);
  }

  /* Homepage variant: full width of the hero, two-up on a phone so the whole
     strip fits one screen, notes one line shorter in weight. */
  .facts.compact { max-width: none; margin: 0; }
  .facts.compact dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 48rem) {
    .facts.compact dl { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .facts.compact .fact { padding: var(--sp-3) var(--sp-4); }
  .facts.compact .fact-note { font-size: var(--fs-xs); }
</style>
