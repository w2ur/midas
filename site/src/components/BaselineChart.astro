---
import { legendEntries } from "./baseline-legend";

type Point = { date: string; portfolio_value: number };

export interface Props {
  agent: Point[];
  benchmark: Point[];
  coinflip: Point[];
  benchmarkLabel: string;
}

const { agent, benchmark, coinflip, benchmarkLabel } = Astro.props;

function pct(series: Point[]): { date: string; val: number }[] {
  if (series.length === 0) return [];
  const base = series[0].portfolio_value;
  if (base === 0) return [];
  return series.map((s) => ({ date: s.date, val: ((s.portfolio_value - base) / base) * 100 }));
}

const a = pct(agent);
const b = pct(benchmark);
const c = pct(coinflip);
const all = [...a, ...b, ...c];

const allDates = Array.from(new Set(all.map((p) => p.date))).sort();
const n = allDates.length;
const dateToIdx = new Map(allDates.map((d, i) => [d, i]));

const WIDTH = 880;
const HEIGHT = 320;
const PAD_L = 52;
const PAD_R = 20;
const PAD_T = 24;
const PAD_B = 38;

const xs = (i: number) =>
  PAD_L + ((WIDTH - PAD_L - PAD_R) * i) / Math.max(n - 1, 1);

const yMin = all.length ? Math.min(0, ...all.map((p) => p.val)) : -1;
const yMax = all.length ? Math.max(0, ...all.map((p) => p.val)) :  1;
const yPad = (yMax - yMin) * 0.08 || 1;
const ymn = yMin - yPad;
const ymx = yMax + yPad;
const ys = (v: number) =>
  PAD_T + ((HEIGHT - PAD_T - PAD_B) * (ymx - v)) / (ymx - ymn);

function pathFor(series: { date: string; val: number }[]): string {
  if (series.length === 0) return "";
  const pts = series
    .map((p) => ({ i: dateToIdx.get(p.date), y: p.val }))
    .filter((p): p is { i: number; y: number } => p.i !== undefined);
  if (pts.length === 0) return "";
  return pts
    .map((p, k) => `${k === 0 ? "M" : "L"} ${xs(p.i).toFixed(1)} ${ys(p.y).toFixed(1)}`)
    .join(" ");
}

const pathAgent = pathFor(a);
const pathBench = pathFor(b);
const pathCoin  = pathFor(c);

// Presence drives BOTH the drawn line and the legend — no orphan legend entries.
const present = {
  agent: pathAgent !== "",
  benchmark: pathBench !== "",
  coinflip: pathCoin !== "",
};
const legend = legendEntries(present);
const seriesMeta: Record<string, { label: string; cls: string }> = {
  agent: { label: "Agent", cls: "sw-agent" },
  benchmark: { label: benchmarkLabel, cls: "sw-bench" },
  coinflip: { label: "Coin flip", cls: "sw-coin" },
};

function endLabel(series: { date: string; val: number }[]): string {
  if (series.length === 0) return "";
  const v = series[series.length - 1].val;
  return `${v >= 0 ? "+" : ""}${v.toFixed(2)}%`;
}

const aEnd = a.length ? a[a.length - 1] : null;
const aEndX = aEnd ? xs(dateToIdx.get(aEnd.date)!) : 0;
const aEndY = aEnd ? ys(aEnd.val) : 0;
const aEndLabel = endLabel(a);
const aLabelY = Math.min(Math.max(aEndY - 12, PAD_T + 12), HEIGHT - PAD_B - 4);

const firstDate = allDates[0] ?? "";
const lastDate = allDates[n - 1] ?? "";
const hasData = n > 0;

// One-sentence summary for assistive tech (the SVG geometry is aria-hidden).
const ariaLabel =
  `Cumulative return since ${firstDate}. Agent ${aEndLabel || "n/a"}` +
  (present.benchmark ? `, ${benchmarkLabel} ${endLabel(b)}` : "") +
  (present.coinflip ? `, coin flip ${endLabel(c)}` : "") + ".";
---
{hasData && (
  <figure class="baseline-chart">
    <div class="chart-head">
      <span class="chart-title">{firstDate} → {lastDate} · cumulative return</span>
      <div class="chart-legend">
        {legend.map((k) => (
          <span class="legend-item">
            <span class={`sw ${seriesMeta[k].cls}`} aria-hidden="true"></span>
            {seriesMeta[k].label}
          </span>
        ))}
      </div>
    </div>

    <svg class="chart-svg" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label={ariaLabel}>
      <g aria-hidden="true">
        {/* gridlines */}
        <line x1={PAD_L} x2={WIDTH - PAD_R} y1={ys(ymx)} y2={ys(ymx)} class="grid" />
        <line x1={PAD_L} x2={WIDTH - PAD_R} y1={ys(ymn)} y2={ys(ymn)} class="grid" />
        {/* zero baseline (stronger) */}
        <line x1={PAD_L} x2={WIDTH - PAD_R} y1={ys(0)} y2={ys(0)} class="baseline" />
        {/* axis frame */}
        <line x1={PAD_L} x2={PAD_L} y1={PAD_T - 4} y2={HEIGHT - PAD_B + 2} class="grid" />

        {/* y-axis labels */}
        <text x={PAD_L - 10} y={ys(ymx) + 4} text-anchor="end" class="label">{ymx.toFixed(1)}%</text>
        <text x={PAD_L - 10} y={ys(0) + 4} text-anchor="end" class="label label-zero">0%</text>
        <text x={PAD_L - 10} y={ys(ymn) + 4} text-anchor="end" class="label">{ymn.toFixed(1)}%</text>

        {/* x-axis labels */}
        <text x={PAD_L} y={HEIGHT - 12} text-anchor="start" class="label">{firstDate}</text>
        <text x={WIDTH - PAD_R} y={HEIGHT - 12} text-anchor="end" class="label">{lastDate}</text>

        {present.coinflip && <path d={pathCoin} class="coin" fill="none" />}
        {present.benchmark && <path d={pathBench} class="bench" fill="none" />}
        {present.agent && <path d={pathAgent} class="agent" fill="none" />}

        {present.agent && (
          <>
            <circle cx={aEndX} cy={aEndY} r="4.5" class="agent-node" />
            <text x={aEndX - 9} y={aLabelY} text-anchor="end" class="agent-end phosphor">{aEndLabel}</text>
          </>
        )}
      </g>
    </svg>
    <figcaption>Return since Day 1, indexed to each series' first session.</figcaption>
  </figure>
)}
<style>
  .baseline-chart {
    margin: var(--sp-6) 0;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: var(--sp-5) var(--sp-5) var(--sp-4);
  }
  .chart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }
  .chart-title {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }
  .chart-legend { display: flex; gap: var(--sp-4); flex-wrap: wrap; }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .sw { display: inline-block; width: 20px; height: 0; flex: none; }
  .sw-agent { border-top: 3px solid var(--accent); }
  .sw-bench { border-top: 2px solid var(--ref); }
  .sw-coin  { border-top: 2px dashed var(--ink-faint); }

  .chart-svg { display: block; width: 100%; height: auto; }

  .grid { stroke: var(--rule); stroke-width: 1; }
  .baseline { stroke: var(--rule-strong); stroke-width: 1.5; }
  .label {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 13px;
    fill: var(--ink-muted);
  }
  .label-zero { fill: var(--ink); }

  .coin  { stroke: var(--ink-faint); stroke-width: 2; stroke-dasharray: 5 4; stroke-linejoin: round; stroke-linecap: round; }
  .bench { stroke: var(--ref); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .agent { stroke: var(--accent); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  .agent-node { fill: var(--accent); }
  .agent-end {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 500;
    fill: var(--accent);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    margin-top: var(--sp-3);
    letter-spacing: 0.02em;
  }
</style>
