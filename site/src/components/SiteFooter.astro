---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <nav class="secondary" aria-label="More">
    <ul>
      <li><a href="/feed">Feed</a></li>
      <li><a href="/archive">Archive</a></li>
      <li><a href="/open-source">Source</a></li>
      <li><a href="/methodology/changelog">Changelog</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </nav>
  <div class="inner">
    <p class="credit">Made with care by <a href="https://william.revah.paris">William</a> &middot; &copy; {year} &middot; <a href="/open-source">The engine is open source</a></p>
    <p class="tagline">Nothing is real money, yet. Paper simulation, not financial advice.</p>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    padding: var(--sp-5) 0 var(--sp-6);
    background: var(--bg);
  }
  /* Secondary nav — the pages that left the masthead on 2026-09-18. Kept on
     every page so internal linking and the sitemap are unchanged. */
  .secondary ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    list-style: none;
    max-width: var(--page-max);
    margin: 0 auto var(--sp-4);
    padding: 0 var(--gutter);
  }
  .secondary a {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .secondary a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  /* Phone: each secondary link is a 44px target, not a 12px line of type. */
  @media (max-width: 48rem) {
    .secondary ul { row-gap: 0; margin-bottom: var(--sp-2); }
    .secondary a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  .inner {
    display: flex;
    gap: var(--sp-3) var(--sp-5);
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .site-footer p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.03em;
    color: var(--ink-muted);
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-footer a:hover { color: var(--ink); }

  /* The honest tagline shows at every width: most visitors arrive on a phone,
     and the front page leads with a real-looking fill. It sits to the right
     on wide viewports and under the credit line on narrow ones. */
</style>
