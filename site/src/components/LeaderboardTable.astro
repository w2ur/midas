---
import type { LeaderboardRow } from "@/lib/output";
import { getAgent, isTradingAgent } from "@/lib/roster";

interface Props {
  rows: LeaderboardRow[];
  reference?: { label: string; return_pct: number | null };
  showVsBench?: boolean;
  vsBenchByAgent?: Record<string, number | null>;
  showVsCoinflip?: boolean;
  vsCoinflipByAgent?: Record<string, number | null>;
  updatedAt?: string;
  trigger?: string;
}

const { rows, reference, showVsBench, vsBenchByAgent, showVsCoinflip, vsCoinflipByAgent, updatedAt, trigger } = Astro.props;

function fmtPct(n: number): string {
  const sign = n > 0 ? "+" : n < 0 ? "" : "";
  return `${sign}${n.toFixed(2)}%`;
}

function fmtDelta(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  const s = v >= 0 ? "+" : "";
  return `${s}${v.toFixed(2)} pts`;
}

function deltaCls(v: number | null | undefined): string {
  if (v === null || v === undefined) return "";
  return v > 0 ? "pos" : v < 0 ? "neg" : "";
}

function formatUpdatedAt(iso: string): string {
  const d = new Date(iso);
  return d.toUTCString().replace("GMT", "UTC");
}

function formatTrigger(t: string): string {
  if (t === "scheduled-weekend-refresh") return "weekend refresh";
  if (t === "trigger-fire") return "conditional order fire";
  if (t.startsWith("session-")) return `session ${t.slice(8)}`;
  return t;
}
---
{updatedAt && (
  <p class="leaderboard-meta">
    Last updated: {formatUpdatedAt(updatedAt)}
    {trigger && <> &middot; via {formatTrigger(trigger)}</>}
  </p>
)}
<table class="leaderboard">
  <thead>
    <tr>
      <th style="width:3rem">#</th>
      <th>Agent</th>
      <th>Archetype</th>
      <th class="num">Return (EUR)</th>
      {showVsBench && <th class="num">vs Bench</th>}
      {showVsCoinflip && <th class="num">vs Coin-flip</th>}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => {
      const tradingAgent = isTradingAgent(row.agent) ? getAgent(row.agent) : null;
      const display = tradingAgent?.display_name ?? row.agent;
      const arch = tradingAgent?.archetype ?? "";
      const cls = row.return_pct > 0 ? "pos" : row.return_pct < 0 ? "neg" : "";
      const vs = vsBenchByAgent?.[row.agent];
      const vcf = vsCoinflipByAgent?.[row.agent];
      return (
        <tr>
          <td class="num">{row.rank}</td>
          <td><a href={`/arena/${row.agent}`}>{display}</a></td>
          <td>{arch}</td>
          <td class={`num ${cls}`}>{fmtPct(row.return_pct)}</td>
          {showVsBench && <td class={`num ${deltaCls(vs)}`}>{fmtDelta(vs)}</td>}
          {showVsCoinflip && <td class={`num ${deltaCls(vcf)}`}>{fmtDelta(vcf)}</td>}
        </tr>
      );
    })}
  </tbody>
  {reference && (
    <tfoot>
      <tr class="reference-row">
        <td>—</td>
        <td colspan="2"><em>{reference.label}</em></td>
        <td class="num muted">
          {reference.return_pct === null ? "—" : fmtPct(reference.return_pct)}
        </td>
        {showVsBench && <td></td>}
        {showVsCoinflip && <td></td>}
      </tr>
    </tfoot>
  )}
</table>
<p class="leaderboard-disclaimer">
  Early-stage experiment — results so far are statistical noise, not skill. Each agent is shown vs a passive benchmark and a random-trade (coin-flip) control.
  <a href="/methodology">See Methodology.</a>
</p>
<style>
  .leaderboard-meta {
    margin: 0 0 0.5rem 0;
    font-size: 0.85rem;
    color: var(--ink-muted);
  }
  .leaderboard-disclaimer {
    margin: 0.75rem 0 0;
    font-size: var(--fs-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .leaderboard-disclaimer a { color: var(--ink-muted); }
  .leaderboard-disclaimer a:hover { color: var(--accent); }
  .reference-row td { color: var(--ink-muted); border-top: 2px solid var(--rule); }
  .reference-row em { font-style: italic; }
  .reference-row .muted { font-style: italic; }
</style>
