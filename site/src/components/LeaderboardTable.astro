---
import type { LeaderboardRow } from "@/lib/output";
import { getAgent, isTradingAgent, type AgentId } from "@/lib/roster";
import { AGENT_BENCHMARK_LABELS } from "@/lib/baselines";
import { boardLayout } from "@/lib/board-sort";
import AgentCrest from "@/components/AgentCrest.astro";

interface Props {
  rows: LeaderboardRow[];
  reference?: { label: string; return_pct: number | null };
  showVsBench?: boolean;
  showVsCoinflip?: boolean;
  updatedAt?: string;
  trigger?: string;
  /**
   * Which column the board arrives sorted by. The live board passes
   * "vsBench" (the artifact's `rank` is ordered by it since 2026-08-14).
   * The default, "artifact", asserts nothing: rows render in the published
   * artifact's own rank order, no column is marked sorted, and the client
   * never reorders until the reader asks — archive pages hold bundles from
   * both ranking eras, so any fixed column claim would be wrong for one of
   * them, and a client-side re-sort would rewrite published ranks.
   */
  initialSort?: "return" | "vsBench" | "vsCoin" | "artifact";
}

const { rows, reference, showVsBench, showVsCoinflip, updatedAt, trigger } = Astro.props;
const initialSort = Astro.props.initialSort ?? "artifact";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function fmtPct(n: number): string {
  // toFixed carries its own minus; only the gain needs an explicit "+".
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)}%`;
}

function fmtDeltaShort(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  const s = v > 0 ? "+" : "";
  return `${s}${v.toFixed(2)}`;
}

function deltaCls(v: number | null | undefined): string {
  if (v === null || v === undefined) return "";
  return v > 0 ? "pos" : v < 0 ? "neg" : "";
}

function formatTrigger(t: string): string {
  if (t === "scheduled-weekend-refresh") return "weekend refresh";
  if (t === "trigger-fire") return "conditional order fire";
  if (t.startsWith("session-")) return `session ${t.slice(8)}`;
  return t;
}

function fmtStampShort(iso: string): string {
  const d = new Date(iso);
  const day = String(d.getUTCDate()).padStart(2, "0");
  const hh = String(d.getUTCHours()).padStart(2, "0");
  const mm = String(d.getUTCMinutes()).padStart(2, "0");
  return `${day} ${MONTHS[d.getUTCMonth()].toUpperCase()} · ${hh}:${mm} UTC`;
}

// "LIVE" only for an intraday conditional-order fire; every settled writer is "CLOSED".
const isLive = trigger === "trigger-fire";
const stampText = updatedAt
  ? `${isLive ? "Live" : "Session closed"} · ${fmtStampShort(updatedAt)}${trigger ? " · " + formatTrigger(trigger) : ""}`
  : null;

// What the row leads with, and whether the decomposition pair renders —
// derived from the rows themselves, unit-tested in lib/board-sort.
const { leadIsExcess, showDecomp } = boardLayout(rows, Boolean(showVsBench));

function leadValue(r: LeaderboardRow): number | null {
  return leadIsExcess ? r.vs_benchmark_pp ?? null : r.return_pct;
}

// Diverging bar: the largest absolute lead value maps to a half-width (50%)
// bar. The reference row only contributes when the lead is the raw return —
// a passive benchmark has no excess over itself.
const maxAbs = Math.max(
  0.01,
  ...rows.map((r) => Math.abs(leadValue(r) ?? 0)),
  !leadIsExcess && reference && reference.return_pct !== null ? Math.abs(reference.return_pct) : 0,
);
function barWidth(pct: number): number {
  return Math.min(50, (Math.abs(pct) / maxAbs) * 50);
}

const hasDeltas = leadIsExcess || Boolean(showVsBench || showVsCoinflip);

// Desktop ledger grid. Two strings: the narrow one drops the decomposition
// pair, which needs ~11rem the 48rem breakpoint does not have to give.
const excessCols = `2.4rem 2rem minmax(0,1fr) 7rem minmax(4rem,1fr) 5.5rem${showVsCoinflip ? " 5rem" : ""}`;
const excessColsWide = showDecomp
  ? `2.4rem 2rem minmax(0,1fr) 7rem minmax(4rem,1fr) 5.5rem 6.5rem 4.5rem${showVsCoinflip ? " 5rem" : ""}`
  : excessCols;
const legacyTrailing = [showVsBench ? "5rem" : "", showVsCoinflip ? "5rem" : ""].filter(Boolean).join(" ");
const legacyCols = `2.4rem 2rem minmax(0,1fr) 6.5rem minmax(4.5rem,1fr)${legacyTrailing ? " " + legacyTrailing : ""}`;
const boardCols = leadIsExcess ? excessCols : legacyCols;
const boardColsWide = leadIsExcess ? excessColsWide : legacyCols;

function fmtPP(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  const s = v > 0 ? "+" : "";
  return `${s}${v.toFixed(2)} pp`;
}

const refPct = reference?.return_pct ?? null;
const refDir = refPct !== null && refPct < 0 ? "n" : "p";
const refW = refPct === null || leadIsExcess ? 0 : barWidth(refPct);
---
{stampText && (
  <p class={`board-stamp ${isLive ? "live" : ""}`.trim()}>
    <span class="sq" aria-hidden="true"></span>{stampText}
  </p>
)}

<div class="board-sorts" data-board-sorts hidden>
  <span class="bs-lab">Sort</span>
  <button type="button" class="bs-chip" data-chip-key="return" aria-pressed={initialSort === "return" ? "true" : "false"}>Return</button>
  {showVsBench && <button type="button" class="bs-chip" data-chip-key="vsBench" aria-pressed={initialSort === "vsBench" ? "true" : "false"}>vs Bench</button>}
  {showVsCoinflip && <button type="button" class="bs-chip" data-chip-key="vsCoin" aria-pressed={initialSort === "vsCoin" ? "true" : "false"}>vs Coin</button>}
</div>

<div
  class={`board ${leadIsExcess ? "lead-excess" : ""} ${showDecomp ? "has-decomp" : ""}`.trim()}
  role="table"
  aria-label="End-of-session leaderboard"
  style={`--board-cols:${boardCols};--board-cols-wide:${boardColsWide}`}
  data-initial-sort={initialSort}
  data-lead-key={leadIsExcess ? "vsBench" : "return"}
>
  <div class="lhead" role="row">
    <span role="columnheader">Rank</span>
    <span role="columnheader" aria-hidden="true"></span>
    <span role="columnheader">Agent</span>
    {leadIsExcess ? (
      <>
        <span role="columnheader" class="ta-r" data-sort-key="vsBench" aria-sort={initialSort === "vsBench" ? "descending" : "none"}>vs Bench</span>
        <span role="columnheader" class="ta-c">Excess</span>
        <span role="columnheader" class="ta-r" data-sort-key="return" aria-sort={initialSort === "return" ? "descending" : "none"}>Ret EUR</span>
        {showDecomp && <span role="columnheader" class="ta-r col-decomp">Ret local</span>}
        {showDecomp && <span role="columnheader" class="ta-r col-decomp">FX</span>}
      </>
    ) : (
      <>
        <span role="columnheader" class="ta-r" data-sort-key="return" aria-sort={initialSort === "return" ? "descending" : "none"}>Return EUR</span>
        <span role="columnheader" class="ta-c">P&amp;L</span>
        {showVsBench && <span role="columnheader" class="ta-r" data-sort-key="vsBench" aria-sort={initialSort === "vsBench" ? "descending" : "none"}>vs Bench</span>}
      </>
    )}
    {showVsCoinflip && <span role="columnheader" class="ta-r" data-sort-key="vsCoin" aria-sort={initialSort === "vsCoin" ? "descending" : "none"}>vs Coin</span>}
  </div>

  {rows.map((row) => {
    const tradingAgent = isTradingAgent(row.agent) ? getAgent(row.agent) : null;
    const display = tradingAgent?.display_name ?? row.agent;
    const arch = tradingAgent?.archetype ?? "";
    const vs = row.vs_benchmark_pp ?? null;
    const vcf = row.vs_coinflip_pp ?? null;
    const local = row.return_local_pct ?? null;
    const fx = row.fx_translation_pp ?? null;
    const benchLabel = AGENT_BENCHMARK_LABELS[row.agent] ?? null;
    // The lead cell carries the row's headline figure; in excess mode a null
    // (no baseline series) renders "—" and draws no bar, never a zero one.
    const lead = leadValue(row);
    const leadCls = lead === null ? "" : lead > 0 ? "pos" : lead < 0 ? "neg" : "";
    const dir = (lead ?? 0) >= 0 ? "p" : "n";
    const w = lead === null ? 0 : barWidth(lead);
    const isLeader = row.rank === 1;
    return (
      <div
        class={`lrow ${isLeader ? "leader" : ""}`.trim()}
        role="row"
        data-agent={row.agent}
        data-return={row.return_pct.toFixed(4)}
        data-vs-bench={vs === null || vs === undefined ? "" : vs.toFixed(4)}
        data-vs-coin={vcf === null || vcf === undefined ? "" : vcf.toFixed(4)}
      >
        <div class="l-id" role="presentation">
          <span class="l-rank" role="cell">{row.rank}</span>
          {tradingAgent
            ? <AgentCrest id={row.agent as AgentId} size={30} />
            : <span class="l-chip" aria-hidden="true">{row.agent.charAt(0).toUpperCase()}</span>
          }
          <div class="l-agent" role="cell">
            <a class="l-nm" href={`/arena/${row.agent}`}>{display}</a>
            {arch && <span class="l-arch">{arch}</span>}
          </div>
        </div>
        <div class="l-fig" role="presentation">
          <div class="l-lead" role="cell">
            <span class={`l-lead-fig ${leadCls}`.trim()}>
              {leadIsExcess ? fmtPP(lead) : fmtPct(row.return_pct)}
            </span>
            {leadIsExcess && benchLabel && <span class="l-lead-sub">vs {benchLabel}</span>}
          </div>
          <div class="l-bar" aria-hidden="true">
            {lead !== null && <span class={`fill ${dir}`} style={`width:${w.toFixed(2)}%`}></span>}
          </div>
        </div>
        {hasDeltas && (
          <div class="l-vs" role="presentation">
            {leadIsExcess ? (
              <>
                <span class="l-ret2" role="cell"><span class="k">ret eur</span> <span class={`v ${deltaCls(row.return_pct)}`.trim()}>{fmtPct(row.return_pct)}</span></span>
                {showDecomp && (
                  <span class="l-local col-decomp" role="cell">
                    <span class="k">ret local</span>{" "}
                    <span class={`v ${deltaCls(local)}`.trim()}>
                      {local === null ? "—" : `${fmtPct(local)} ${row.currency ?? ""}`.trim()}
                    </span>
                  </span>
                )}
                {showDecomp && (
                  <span class="l-fx col-decomp" role="cell"><span class="k">fx</span> <span class={`v ${deltaCls(fx)}`.trim()}>{fmtDeltaShort(fx)}</span></span>
                )}
              </>
            ) : (
              showVsBench && (
                <span class="l-bench" role="cell"><span class="k">vs bench</span> <span class={`v ${deltaCls(vs)}`.trim()}>{fmtDeltaShort(vs)}</span></span>
              )
            )}
            {showVsCoinflip && (
              <span class="l-coin" role="cell"><span class="k">vs coin</span> <span class={`v ${deltaCls(vcf)}`.trim()}>{fmtDeltaShort(vcf)}</span></span>
            )}
          </div>
        )}
      </div>
    );
  })}

  {reference && (
    <div class="lrow ref" role="row">
      <div class="l-id" role="presentation">
        <span class="l-rank" role="cell">—</span>
        <span class="l-chip" aria-hidden="true">{reference.label.charAt(0)}</span>
        <div class="l-agent" role="cell">
          <span class="l-nm">{reference.label}</span>
          <span class="l-arch">passive reference</span>
        </div>
      </div>
      <div class="l-fig" role="presentation">
        <div class="l-lead" role="cell">
          {/* A passive reference has no excess over itself: in excess mode the
              headline cell states that rather than borrowing its own return. */}
          <span class="l-lead-fig">{leadIsExcess ? "ref" : refPct === null ? "—" : fmtPct(refPct)}</span>
        </div>
        <div class="l-bar" aria-hidden="true">
          {refPct !== null && !leadIsExcess && <span class={`fill ${refDir}`} style={`width:${refW.toFixed(2)}%`}></span>}
        </div>
      </div>
      {hasDeltas && (
        <div class="l-vs" role="presentation">
          {leadIsExcess ? (
            <>
              <span class="l-ret2" role="cell"><span class="k">ret eur</span> <span class="v ref-val">{refPct === null ? "—" : fmtPct(refPct)}</span></span>
              {showDecomp && <span class="l-local col-decomp" role="cell"><span class="k">ret local</span> <span class="v ref-val">—</span></span>}
              {showDecomp && <span class="l-fx col-decomp" role="cell"><span class="k">fx</span> <span class="v ref-val">—</span></span>}
            </>
          ) : (
            showVsBench && <span class="l-bench" role="cell"><span class="k">vs bench</span> <span class="v ref-val">ref</span></span>
          )}
          {showVsCoinflip && <span class="l-coin" role="cell"><span class="k">vs coin</span> <span class="v ref-val">ref</span></span>}
        </div>
      )}
    </div>
  )}
</div>

<p class="leaderboard-disclaimer">
  Early-stage experiment — results so far are statistical noise, not skill. Each agent is shown vs a passive benchmark and a random-trade (coin-flip) control.
  <a href="/methodology">See Methodology.</a>
</p>

<script>
  import { orderRows, parseValue, type SortDir, type SortKey, type SortRec } from "@/lib/board-sort";

  function initBoard(board: HTMLElement) {
    const rowEls = Array.from(board.querySelectorAll<HTMLElement>(".lrow[data-agent]"));
    if (rowEls.length === 0) return;

    const byAgent = new Map<string, HTMLElement>();
    const recs: SortRec[] = [];
    for (const el of rowEls) {
      const agent = el.dataset.agent;
      if (!agent) continue;
      byAgent.set(agent, el);
      recs.push({
        agent,
        return_pct: parseValue(el.dataset.return) ?? 0,
        vsBench: parseValue(el.dataset.vsBench),
        vsCoin: parseValue(el.dataset.vsCoin),
      });
    }

    const refRow = board.querySelector<HTMLElement>(".lrow.ref");
    const headers = Array.from(board.querySelectorAll<HTMLElement>("[data-sort-key]"));
    const chipBar = board.parentElement?.querySelector<HTMLElement>("[data-board-sorts]") ?? null;
    const chips = chipBar ? Array.from(chipBar.querySelectorAll<HTMLElement>("[data-chip-key]")) : [];

    const declared = board.dataset.initialSort;
    // null = "artifact" mode: the server-rendered order IS the published
    // ranking; nothing is reordered until the reader picks a column.
    let activeKey: SortKey | null =
      declared === "return" || declared === "vsBench" || declared === "vsCoin"
        ? declared
        : null;
    let activeDir: SortDir = "desc";

    function apply() {
      if (activeKey === null) return;
      const order = orderRows(recs, activeKey, activeDir);
      for (const agent of order) {
        const el = byAgent.get(agent);
        if (el) board.appendChild(el);
      }
      if (refRow) board.appendChild(refRow);

      order.forEach((agent, i) => {
        const el = byAgent.get(agent);
        if (!el) return;
        const rank = el.querySelector(".l-rank");
        if (rank) rank.textContent = String(i + 1);
        el.classList.toggle("leader", i === 0);
      });

      // The #1 phosphor accents the LEAD figure, which is only the reason
      // this row is on top while the board is sorted by the lead metric.
      // Sorted by another column, it would highlight one number while a
      // different one decided the order — the same self-contradiction the
      // lead-metric change removed, reintroduced by a click.
      board.classList.toggle("off-metric", activeKey !== board.dataset.leadKey);

      for (const h of headers) {
        const isActive = h.dataset.sortKey === activeKey;
        h.setAttribute("aria-sort", isActive ? (activeDir === "desc" ? "descending" : "ascending") : "none");
        h.classList.toggle("is-active", isActive);
        h.classList.toggle("is-asc", isActive && activeDir === "asc");
      }
      for (const c of chips) {
        c.setAttribute("aria-pressed", String(c.dataset.chipKey === activeKey));
      }
    }

    function select(key: SortKey) {
      if (key === activeKey) {
        activeDir = activeDir === "desc" ? "asc" : "desc";
      } else {
        activeKey = key;
        activeDir = "desc";
      }
      apply();
    }

    // Upgrade each sortable header's text into a real button. Done here rather
    // than in the template so the no-JS page has no dead controls.
    for (const h of headers) {
      const key = h.dataset.sortKey as SortKey | undefined;
      if (!key) continue;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "sort-btn";
      btn.textContent = h.textContent?.trim() ?? "";
      const caret = document.createElement("span");
      caret.className = "sort-caret";
      caret.setAttribute("aria-hidden", "true");
      btn.appendChild(caret);
      btn.addEventListener("click", () => select(key));
      h.replaceChildren(btn);
    }

    for (const c of chips) {
      const key = c.dataset.chipKey as SortKey | undefined;
      if (!key) continue;
      c.addEventListener("click", () => select(key));
    }
    if (chipBar) chipBar.hidden = false;

    apply();
  }

  for (const board of document.querySelectorAll<HTMLElement>(".board")) {
    initBoard(board);
  }
</script>

<style>
  /* ── Session stamp above the board ── */
  .board-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-sm);
    padding: 0.35rem 0.6rem;
    margin: 0 0 var(--sp-4);
  }
  .board-stamp .sq { width: 7px; height: 7px; border-radius: 2px; background: var(--neg); flex: none; }
  .board-stamp.live { color: var(--accent); }
  .board-stamp.live .sq { background: var(--accent); }

  .board { margin: 0; }

  /* ── MOBILE-FIRST: each row is a stacked card. No horizontal overflow at 360px. ── */
  .lhead { display: none; }

  .lrow {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem 0.5rem 0.85rem 0.95rem;
    border-bottom: 1px solid var(--rule);
  }
  .lrow:last-child { border-bottom: 0; }
  .lrow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--agent-color, var(--rule-strong));
    opacity: 0.9;
  }

  /* line 1 — rank + crest + name + archetype */
  .l-id { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .l-rank {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--ink-muted);
    flex: none;
    min-width: 1.2rem;
  }
  /* reference-row letter chip (e.g. MSCI World "M") — initial stays in the row colour */
  .l-chip {
    width: 30px;
    height: 30px;
    border-radius: var(--r-sm);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    color: var(--agent-color, var(--ink-muted));
    background: var(--bg-elev2);
    border: 1px solid var(--agent-color, var(--rule));
  }
  .l-agent { min-width: 0; flex: 1; }
  .l-nm {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a.l-nm:hover { color: var(--accent); }
  .l-arch {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* line 2 — big headline figure (excess, or return on legacy bundles) + bar */
  .l-fig { display: flex; align-items: center; gap: 0.75rem; }
  .l-lead { flex: none; min-width: 0; }
  .l-lead-fig {
    display: block;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    font-weight: 500;
    white-space: nowrap;
    line-height: 1.15;
  }
  .l-lead-fig.pos { color: var(--pos); }
  .l-lead-fig.neg { color: var(--neg); }
  /* Names what the excess is measured against, so "vs Bench" is never an
     unlabelled subtraction. Each agent has its own pre-registered benchmark. */
  .l-lead-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .l-bar {
    position: relative;
    flex: 1;
    height: 7px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .l-bar::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -3px;
    bottom: -3px;
    width: 1px;
    background: var(--rule-strong);
  }
  .l-bar .fill { position: absolute; top: 0; bottom: 0; border-radius: 2px; }
  .l-bar .fill.p { left: 50%; background: var(--pos); opacity: 0.85; }
  .l-bar .fill.n { right: 50%; background: var(--neg); opacity: 0.85; }

  /* line 3 — secondary figures as chips (desktop unwraps them into columns) */
  .l-vs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .l-bench, .l-coin, .l-ret2, .l-local, .l-fx {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    background: var(--bg-elev2);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
  }
  .l-bench .k, .l-coin .k, .l-ret2 .k, .l-local .k, .l-fx .k {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  .l-bench .v, .l-coin .v, .l-ret2 .v, .l-local .v, .l-fx .v { font-weight: 500; }
  .v.pos { color: var(--pos); }
  .v.neg { color: var(--neg); }

  /* ── #1 leader — restrained amber phosphor (the leader figure is the phosphor) ── */
  .lrow.leader {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 11%, transparent) 0%, transparent 62%);
  }
  .lrow.leader::before { background: var(--accent); opacity: 1; box-shadow: var(--phosphor); }
  .lrow.leader .l-rank { color: var(--accent); }
  /* The phosphor marks the RANKED figure — which is the excess, not the EUR
     return, whenever the board is led by it. Suppressed under `.off-metric`
     (set by the sort script when the reader orders on another column), where
