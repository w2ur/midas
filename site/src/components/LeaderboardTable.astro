---
import type { LeaderboardRow } from "@/lib/output";
import { getAgent, isTradingAgent, type AgentId } from "@/lib/roster";
import AgentCrest from "@/components/AgentCrest.astro";

interface Props {
  rows: LeaderboardRow[];
  reference?: { label: string; return_pct: number | null };
  showVsBench?: boolean;
  vsBenchByAgent?: Record<string, number | null>;
  showVsCoinflip?: boolean;
  vsCoinflipByAgent?: Record<string, number | null>;
  updatedAt?: string;
  trigger?: string;
}

const { rows, reference, showVsBench, vsBenchByAgent, showVsCoinflip, vsCoinflipByAgent, updatedAt, trigger } = Astro.props;

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

function fmtPct(n: number): string {
  // toFixed carries its own minus; only the gain needs an explicit "+".
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)}%`;
}

function fmtDeltaShort(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  const s = v > 0 ? "+" : "";
  return `${s}${v.toFixed(2)}`;
}

function deltaCls(v: number | null | undefined): string {
  if (v === null || v === undefined) return "";
  return v > 0 ? "pos" : v < 0 ? "neg" : "";
}

function formatTrigger(t: string): string {
  if (t === "scheduled-weekend-refresh") return "weekend refresh";
  if (t === "trigger-fire") return "conditional order fire";
  if (t.startsWith("session-")) return `session ${t.slice(8)}`;
  return t;
}

function fmtStampShort(iso: string): string {
  const d = new Date(iso);
  const day = String(d.getUTCDate()).padStart(2, "0");
  const hh = String(d.getUTCHours()).padStart(2, "0");
  const mm = String(d.getUTCMinutes()).padStart(2, "0");
  return `${day} ${MONTHS[d.getUTCMonth()].toUpperCase()} · ${hh}:${mm} UTC`;
}

// "LIVE" only for an intraday conditional-order fire; every settled writer is "CLOSED".
const isLive = trigger === "trigger-fire";
const stampText = updatedAt
  ? `${isLive ? "Live" : "Session closed"} · ${fmtStampShort(updatedAt)}${trigger ? " · " + formatTrigger(trigger) : ""}`
  : null;

// Diverging P&L bar: the largest absolute return maps to a half-width (50%) bar.
const maxAbs = Math.max(
  0.01,
  ...rows.map((r) => Math.abs(r.return_pct)),
  reference && reference.return_pct !== null ? Math.abs(reference.return_pct) : 0,
);
function barWidth(pct: number): number {
  return Math.min(50, (Math.abs(pct) / maxAbs) * 50);
}

const hasDeltas = Boolean(showVsBench || showVsCoinflip);

// Desktop ledger grid; the two vs-columns are conditional (archive view omits them).
const trailing = [showVsBench ? "5rem" : "", showVsCoinflip ? "5rem" : ""].filter(Boolean).join(" ");
const boardCols = `2.4rem 2rem minmax(0,1fr) 6.5rem minmax(4.5rem,1fr)${trailing ? " " + trailing : ""}`;

const refPct = reference?.return_pct ?? null;
const refDir = refPct !== null && refPct < 0 ? "n" : "p";
const refW = refPct === null ? 0 : barWidth(refPct);
---
{stampText && (
  <p class={`board-stamp ${isLive ? "live" : ""}`.trim()}>
    <span class="sq" aria-hidden="true"></span>{stampText}
  </p>
)}

<div class="board" role="table" aria-label="End-of-session leaderboard" style={`--board-cols:${boardCols}`}>
  <div class="lhead" role="row">
    <span role="columnheader">Rank</span>
    <span role="columnheader" aria-hidden="true"></span>
    <span role="columnheader">Agent</span>
    <span role="columnheader" class="ta-r">Return EUR</span>
    <span role="columnheader" class="ta-c">P&amp;L</span>
    {showVsBench && <span role="columnheader" class="ta-r">vs Bench</span>}
    {showVsCoinflip && <span role="columnheader" class="ta-r">vs Coin</span>}
  </div>

  {rows.map((row) => {
    const tradingAgent = isTradingAgent(row.agent) ? getAgent(row.agent) : null;
    const display = tradingAgent?.display_name ?? row.agent;
    const arch = tradingAgent?.archetype ?? "";
    const retCls = row.return_pct > 0 ? "pos" : row.return_pct < 0 ? "neg" : "";
    const dir = row.return_pct >= 0 ? "p" : "n";
    const w = barWidth(row.return_pct);
    const vs = vsBenchByAgent?.[row.agent];
    const vcf = vsCoinflipByAgent?.[row.agent];
    const isLeader = row.rank === 1;
    return (
      <div class={`lrow ${isLeader ? "leader" : ""}`.trim()} role="row" data-agent={row.agent}>
        <div class="l-id" role="presentation">
          <span class="l-rank" role="cell">{row.rank}</span>
          {tradingAgent
            ? <AgentCrest id={row.agent as AgentId} size={30} />
            : <span class="l-chip" aria-hidden="true">{row.agent.charAt(0).toUpperCase()}</span>
          }
          <div class="l-agent" role="cell">
            <a class="l-nm" href={`/arena/${row.agent}`}>{display}</a>
            {arch && <span class="l-arch">{arch}</span>}
          </div>
        </div>
        <div class="l-fig" role="presentation">
          <span class={`l-ret ${retCls}`.trim()} role="cell">{fmtPct(row.return_pct)}</span>
          <div class="l-bar" aria-hidden="true">
            <span class={`fill ${dir}`} style={`width:${w.toFixed(2)}%`}></span>
          </div>
        </div>
        {hasDeltas && (
          <div class="l-vs" role="presentation">
            {showVsBench && (
              <span class="l-bench" role="cell"><span class="k">vs bench</span> <span class={`v ${deltaCls(vs)}`.trim()}>{fmtDeltaShort(vs)}</span></span>
            )}
            {showVsCoinflip && (
              <span class="l-coin" role="cell"><span class="k">vs coin</span> <span class={`v ${deltaCls(vcf)}`.trim()}>{fmtDeltaShort(vcf)}</span></span>
            )}
          </div>
        )}
      </div>
    );
  })}

  {reference && (
    <div class="lrow ref" role="row">
      <div class="l-id" role="presentation">
        <span class="l-rank" role="cell">—</span>
        <span class="l-chip" aria-hidden="true">{reference.label.charAt(0)}</span>
        <div class="l-agent" role="cell">
          <span class="l-nm">{reference.label}</span>
          <span class="l-arch">passive reference</span>
        </div>
      </div>
      <div class="l-fig" role="presentation">
        <span class="l-ret" role="cell">{refPct === null ? "—" : fmtPct(refPct)}</span>
        <div class="l-bar" aria-hidden="true">
          {refPct !== null && <span class={`fill ${refDir}`} style={`width:${refW.toFixed(2)}%`}></span>}
        </div>
      </div>
      {hasDeltas && (
        <div class="l-vs" role="presentation">
          {showVsBench && <span class="l-bench" role="cell"><span class="k">vs bench</span> <span class="v ref-val">ref</span></span>}
          {showVsCoinflip && <span class="l-coin" role="cell"><span class="k">vs coin</span> <span class="v ref-val">ref</span></span>}
        </div>
      )}
    </div>
  )}
</div>

<p class="leaderboard-disclaimer">
  Early-stage experiment — results so far are statistical noise, not skill. Each agent is shown vs a passive benchmark and a random-trade (coin-flip) control.
  <a href="/methodology">See Methodology.</a>
</p>

<style>
  /* ── Session stamp above the board ── */
  .board-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-sm);
    padding: 0.35rem 0.6rem;
    margin: 0 0 var(--sp-4);
  }
  .board-stamp .sq { width: 7px; height: 7px; border-radius: 2px; background: var(--neg); flex: none; }
  .board-stamp.live { color: var(--accent); }
  .board-stamp.live .sq { background: var(--accent); }

  .board { margin: 0; }

  /* ── MOBILE-FIRST: each row is a stacked card. No horizontal overflow at 360px. ── */
  .lhead { display: none; }

  .lrow {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem 0.5rem 0.85rem 0.95rem;
    border-bottom: 1px solid var(--rule);
  }
  .lrow:last-child { border-bottom: 0; }
  .lrow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--agent-color, var(--rule-strong));
    opacity: 0.9;
  }

  /* line 1 — rank + monogram chip + name + archetype */
  .l-id { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .l-rank {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--ink-muted);
    flex: none;
    min-width: 1.2rem;
  }
  /* kit-color monogram chip — initials stay in the kit color (never white-on-kit) */
  .l-chip {
    width: 30px;
    height: 30px;
    border-radius: var(--r-sm);
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-xs);
    color: var(--agent-color, var(--ink-muted));
    background: var(--bg-elev2);
    border: 1px solid var(--agent-color, var(--rule));
  }
  .l-agent { min-width: 0; flex: 1; }
  .l-nm {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a.l-nm:hover { color: var(--accent); }
  .l-arch {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* line 2 — big RETURN + diverging P&L bar */
  .l-fig { display: flex; align-items: center; gap: 0.75rem; }
  .l-ret {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-lg);
    font-weight: 500;
    white-space: nowrap;
    flex: none;
  }
  .l-ret.pos { color: var(--pos); }
  .l-ret.neg { color: var(--neg); }

  .l-bar {
    position: relative;
    flex: 1;
    height: 7px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .l-bar::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -3px;
    bottom: -3px;
    width: 1px;
    background: var(--rule-strong);
  }
  .l-bar .fill { position: absolute; top: 0; bottom: 0; border-radius: 2px; }
  .l-bar .fill.p { left: 50%; background: var(--pos); opacity: 0.85; }
  .l-bar .fill.n { right: 50%; background: var(--neg); opacity: 0.85; }

  /* line 3 — vs-bench / vs-coin chips */
  .l-vs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .l-bench, .l-coin {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    background: var(--bg-elev2);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    padding: 0.2rem 0.5rem;
    white-space: nowrap;
  }
  .l-bench .k, .l-coin .k { text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-muted); }
  .l-bench .v, .l-coin .v { font-weight: 500; }
  .v.pos { color: var(--pos); }
  .v.neg { color: var(--neg); }

  /* ── #1 leader — restrained amber phosphor (the leader figure is the phosphor) ── */
  .lrow.leader {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 11%, transparent) 0%, transparent 62%);
  }
  .lrow.leader::before { background: var(--accent); opacity: 1; box-shadow: var(--phosphor); }
  .lrow.leader .l-rank { color: var(--accent); }
  .lrow.leader .l-ret { color: var(--accent); text-shadow: var(--phosphor); }
  .lrow.leader .l-bar .fill.p { background: var(--accent); opacity: 1; box-shadow: var(--phosphor); }

  /* ── reference footer row (MSCI World) ── */
  .lrow.ref { background: var(--bg-elev2); border-top: 1px solid var(--rule-strong); }
  .lrow.ref::before { background: var(--ref); opacity: 0.75; }
  .lrow.ref .l-rank,
  .lrow.ref .l-nm,
  .lrow.ref .l-ret { color: var(--ref); }
  .lrow.ref .l-nm { font-size: var(--fs-sm); letter-spacing: 0.03em; text-transform: uppercase; }
  .lrow.ref .l-arch { color: var(--ink-muted); }
  .lrow.ref .l-chip { color: var(--ref); border-color: var(--ref); }
  .lrow.ref .l-bar .fill { background: var(--ref); opacity: 0.6; }
  .lrow.ref .v.ref-val { color: var(--ref); }

  /* ── DESKTOP ledger (>=48rem): flush grid rows, hairline separators ── */
  @media (min-width: 48rem) {
    .lhead {
      display: grid;
      grid-template-columns: var(--board-cols);
      column-gap: var(--sp-4);
      align-items: center;
      padding: 0 0.5rem var(--sp-2) 0.95rem;
      border-bottom: 1px solid var(--rule-strong);
    }
    .lhead span {
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .lhead .ta-r { text-align: right; }
    .lhead .ta-c { text-align: center; }

    .lrow {
      display: grid;
      grid-template-columns: var(--board-cols);
      gap: 0 var(--sp-4);
      align-items: center;
      padding: 0 0.5rem 0 0.95rem;
      min-height: 3.6rem;
    }
    /* unwrap the mobile groupings so leaf cells land in the row grid */
    .l-id, .l-fig, .l-vs { display: contents; }

    .l-agent { flex: initial; }
    .l-ret { flex: initial; text-align: right; }
    .l-bar { flex: initial; }

    .l-bench, .l-coin {
      display: block;
      background: none;
      border: 0;
      padding: 0;
      text-align: right;
      font-size: var(--fs-sm);
      color: var(--ink-muted);
      white-space: nowrap;
    }
    .l-bench .k, .l-coin .k { display: none; }
  }

  /* ── Honesty disclaimer — the narrator's caveat, serif italic ── */
  .leaderboard-disclaimer {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: var(--measure-wide);
    margin: var(--sp-5) 0 0;
  }
  .leaderboard-disclaimer a { color: var(--ink-muted); }
  .leaderboard-disclaimer a:hover { color: var(--accent); }
</style>
