---
// StatusRail — the desk's status strip.
//
// A single horizontal readout that sits under the masthead at every breakpoint.
// It replaced a fixed 72px vertical spine whose stamps were set in
// `writing-mode: vertical-rl`: four facts that could only be read by tilting
// your head, at the cost of 72px of viewport on every page. The strip carries
// the same facts (plus the two the mobile variant used to drop) horizontally,
// and the layout gets its gutter back.
//
// All data is build-time static, read from committed artifacts.
import { currentDayNumber } from "@/lib/session";
import { loadCurrentLeaderboard } from "@/lib/leaderboard";
import { loadGlobalReference, returnPct } from "@/lib/baselines";
import { TRADING_AGENTS } from "@/lib/roster";

const day = currentDayNumber();
const agentCount = TRADING_AGENTS.length;
const board = loadCurrentLeaderboard(); // { updated_at, trigger, rows } | null

const msci = returnPct(loadGlobalReference());

function fmtPct(n: number): string {
  // toFixed carries its own minus sign; we only prepend "+" for gains.
  const sign = n > 0 ? "+" : "";
  return `${sign}${n.toFixed(2)}%`;
}
const msciLabel = msci === null ? null : fmtPct(msci);

function hhmmUtc(iso: string): string {
  const d = new Date(iso);
  const h = String(d.getUTCHours()).padStart(2, "0");
  const m = String(d.getUTCMinutes()).padStart(2, "0");
  return `${h}:${m}`;
}

// "LIVE" only for an intraday conditional-order fire (the desk is mid-market);
// every other writer (weekday session close, weekend valuation) is a settled
// readout → "CLOSED". The vertical rail used to print a permanent "LIVE" label
// *above* a stamp reading "CLOSED", which contradicted itself; the strip states
// the session's actual condition once.
const isLive = board?.trigger === "trigger-fire";
const sessionState = isLive ? "Live" : "Closed";
const stamp = board ? hhmmUtc(board.updated_at) : null;

const summary = [
  `Session ${sessionState.toLowerCase()}`,
  stamp ? `last update ${stamp} UTC` : null,
  `day ${day}`,
  msciLabel ? `MSCI World ${msciLabel}` : null,
  `${agentCount} agents`,
].filter(Boolean).join(", ");
---

<div class="status-strip" role="status" aria-label={`Desk status: ${summary}`}>
  <div class="strip-inner">
    <span class={`sv-state ${isLive ? "is-live" : ""}`}>
      <span class="pulse-dot" aria-hidden="true"></span>
      {sessionState}
    </span>

    {stamp && (
      <>
        <span class="sv-sep" aria-hidden="true">·</span>
        <span class="sv-item"><span class="sv-num">{stamp}</span> UTC</span>
      </>
    )}

    <span class="sv-sep" aria-hidden="true">·</span>
    <span class="sv-item">Day <span class="sv-num sv-amber">{day}</span></span>

    {msciLabel && (
      <>
        <span class="sv-sep" aria-hidden="true">·</span>
        <span class="sv-item sv-fold">MSCI <span class="sv-num sv-amber">{msciLabel}</span></span>
      </>
    )}

    <span class="sv-sep sv-fold" aria-hidden="true">·</span>
    <span class="sv-item sv-fold"><span class="sv-num">{agentCount}</span> agents</span>
  </div>
</div>

<style>
  .status-strip {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg-elev2);
    border-bottom: 1px solid var(--rule);
  }
  .strip-inner {
    display: flex;
    align-items: center;
    gap: 0.55ch;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0.4rem var(--gutter);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
  }

  .sv-item { flex: none; }
  .sv-num { color: var(--ink); }
  .sv-amber { color: var(--accent); }
  .sv-sep { color: var(--rule-strong); flex: none; }

  .sv-state {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    flex: none;
    font-weight: 500;
    color: var(--ink);
  }
  .sv-state.is-live { color: var(--accent); }

  /* ── Status dot ── */
  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink-faint);
    flex: none;
  }
  .sv-state.is-live .pulse-dot {
    background: var(--accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  /* Only a genuinely live desk pulses — a settled readout is a static dot, so
     the motion means "mid-market" rather than "the page loaded". */
  @media (prefers-reduced-motion: no-preference) {
    .sv-state.is-live .pulse-dot { animation: strip-pulse 2.4s ease-out infinite; }
  }
  @keyframes strip-pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent),
                       0 0 6px color-mix(in srgb, var(--accent) 60%, transparent); }
    70%  { box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 0%, transparent),
                       0 0 6px color-mix(in srgb, var(--accent) 60%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent),
                       0 0 6px color-mix(in srgb, var(--accent) 60%, transparent); }
  }

  /* Narrow phones keep the session state and the day count; the reference
     figure and the roster size fold away rather than truncating mid-word. */
  @media (max-width: 26rem) {
    .sv-fold { display: none; }
  }

  /* Chrome — never print the status furniture. */
  @media print {
    .status-strip { display: none !important; }
  }
</style>
