---
import type { Order } from "@/lib/orders";
import { tickerSlug } from "@/lib/orders";

interface Props { orders: Order[] }
const { orders } = Astro.props;

function fmtShares(n: number): string {
  if (Math.abs(n) >= 100) return n.toFixed(0);
  if (Math.abs(n) >= 1) return n.toFixed(2).replace(/\.?0+$/, "");
  return n.toFixed(4).replace(/\.?0+$/, "");
}

function fmtPrice(n: number | null, ccy: string | null): string {
  if (n === null) return "—";
  const digits = Math.abs(n) < 10 ? 4 : 2;
  return `${ccy ?? ""} ${n.toFixed(digits)}`.trim();
}
---
<aside class="trade-card" aria-label="Trade details">
  {orders.map((o) => (
    <div class={`row ${o.status}`}>
      <div class="line">
        <span class={`side ${o.action.toLowerCase()}`}>{o.action}</span>
        <a class="tick" href={`/ticker/${tickerSlug(o.ticker)}`}>{o.ticker}</a>
        <span class="shares">{fmtShares(o.shares)} sh</span>
        <span class="at">@</span>
        <span class="px">{fmtPrice(o.fill_price, o.fill_currency)}</span>
        {o.status === "rejected" && <span class="badge rej" title={o.reject_reason ?? ""}>rejected</span>}
        {o.status === "pending" && <span class="badge pen">pending</span>}
      </div>
      {o.status === "rejected" && o.reject_reason && (
        <p class="why rej-why">Rejected: {o.reject_reason}</p>
      )}
      {o.reasoning && o.status !== "rejected" && (
        <p class="why">{o.reasoning}</p>
      )}
    </div>
  ))}
</aside>
