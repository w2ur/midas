---
// The Manager's decision log.
//
// Replaces 36 expanded `<pre>{review.render}</pre>` dumps — 1,000–2,500 chars
// each, ~19 screens in total — with the structure the records already carry.
// Nothing is parsed out of the rendered string: `manager-review/*.json` stores
// `conviction`, `positions[]`, `action`, `size_eur`, `stop_loss`, `trigger`,
// `entry_guidance` and `reasoning` as fields, and the `<pre>` was throwing all
// of that away to print a pre-formatted transcript of it.
//
// `render` is still shipped, behind a per-decision "raw record" toggle: it is
// the artifact the allocator actually emitted, and the point of this desk is
// that the primary record stays reachable.
import type { ManagerReview } from "@/lib/manager";
import DecisionItem from "@/components/DecisionItem.astro";

interface Props {
  reviews: ManagerReview[];
  /** How many decisions render in the open. The rest fold behind one disclosure. */
  openCount?: number;
}
const { reviews, openCount = 3 } = Astro.props as Props;

// Summary above archive (the site-wide rule, 2026-08-07): the most recent
// sessions render in the open, everything older stays in the DOM — crawlable,
// filterable, no-JS readable — behind ONE disclosure. Before this the page
// listed all 66 summary rows and measured 15 phone screens.
const recent = reviews.slice(0, openCount);
const older = reviews.slice(openCount);

/** Explicit HOLD entries are decisions too, but they are not commitments. */
function committed(r: ManagerReview) {
  return r.positions.filter((p) => p.action !== "HOLD");
}

---
<div class="decision-log">
  <div class="dl-filter" role="group" aria-label="Filter decisions">
    <button type="button" data-filter="all" aria-pressed="true">All <span class="dl-n">{reviews.length}</span></button>
    <button type="button" data-filter="act" aria-pressed="false">
      Committed <span class="dl-n">{reviews.filter((r) => committed(r).length > 0).length}</span>
    </button>
    <button type="button" data-filter="hold" aria-pressed="false">
      Held <span class="dl-n">{reviews.filter((r) => committed(r).length === 0).length}</span>
    </button>
  </div>

  <ol class="dl-list">
    {recent.map((r) => <DecisionItem r={r} open={true} />)}
  </ol>

  {older.length > 0 && (
    <details class="dl-archive">
      <summary>
        The full decision log — {older.length} earlier session{older.length > 1 ? "s" : ""}, {reviews[reviews.length - 1].date} to {older[0].date}
      </summary>
      <ol class="dl-list">
        {older.map((r) => <DecisionItem r={r} open={false} />)}
      </ol>
    </details>
  )}
</div>

<script is:inline>
  (function () {
    var root = document.querySelector(".decision-log");
    if (!root) return;
    var buttons = root.querySelectorAll(".dl-filter button");
    var items = root.querySelectorAll(".dl-item");
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var f = btn.getAttribute("data-filter");
        buttons.forEach(function (b) {
          b.setAttribute("aria-pressed", b === btn ? "true" : "false");
        });
        items.forEach(function (it) {
          var show = f === "all" || it.getAttribute("data-kind") === f;
          it.hidden = !show;
        });
      });
    });
  })();
</script>

<style>
  .decision-log { margin-top: var(--sp-4); }

  /* ── Filter ── */
  .dl-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-5);
  }
  .dl-filter button {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    /* 44px minimum touch target without inflating the visual pill. */
    min-height: 2.25rem;
  }
  .dl-filter button:hover { color: var(--ink); border-color: var(--rule-strong); }
  .dl-filter button[aria-pressed="true"] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .dl-n { opacity: 0.7; }

  /* ── List ── */
  .dl-list { list-style: none; margin: 0; padding: 0; }

  /* ── The archive fold ── */
  .dl-archive { margin-top: var(--sp-4); }
  .dl-archive > summary {
    cursor: pointer;
    list-style: none;
    padding: var(--sp-3) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--accent);
  }
  .dl-archive > summary::-webkit-details-marker { display: none; }
  .dl-archive > summary::before { content: "▸ "; }
  .dl-archive[open] > summary::before { content: "▾ "; }
  .dl-archive > summary:hover { color: var(--accent-strong); }
</style>
