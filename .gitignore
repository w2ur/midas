__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
data/cache/
# data/market/ is partially tracked: data/market/ohlcv/ is committed
# (so sandboxed agents can read it); transient snapshots like today.json
# are ignored below.
data/market/today.json
# merge_rows writes {SYMBOL}.jsonl.tmp then renames it. A crashed run leaves the
# orphan behind, and fetch-ohlcv.yml does a blanket `git add data/market/ohlcv/`
# — so without this it would be committed into the store permanently.
data/market/ohlcv/*.tmp
# Locally-generated backtest grid for the dashboard /backtest + /leaderboard
# pages; regenerated on demand via scripts/run_all_combos.py.
data/factor-research.json
.env
.env.*
!.env.example
.DS_Store
.superpowers/
*.db
.worktrees/
.claude/worktrees/
# Ring 1 output artifacts: COMMITTED so the sandbox VM's ephemeral state persists
# across runs (the remote session's files are destroyed at teardown). They become
# the source of truth for Ring 2 (memory citations) and Ring 3 (website history).
#   data/posts/, data/blog/, data/output/, data/orders/ are all tracked.

# Git worktrees
.worktrees/

# Ring 3a — site build artifacts
site/node_modules/
site/dist/
site/.astro/
site/.vercel/

# Stray node_modules at the worktree root (vitest cache occasionally resolves here)
node_modules/

# Sub-agent scratch memory (per-session, not portfolio knowledge)
.claude/agent-memory/

# Playwright MCP verification artifacts (transient screenshots + snapshots)
.playwright-mcp/
/feed-with-tradecards.png
/ticker-sap-de.png
/simulate-*.png

# Session step-state (transient per-day resume markers — not portfolio knowledge)
data/session_state/

# Plan files (plans live in ~/.claude/plans/, never in the repo)
docs/plans/
# Superpowers artefacts — plans AND design specs — never live in the repo.
# Owner decision 2026-08-08, overriding the earlier "keep specs/" carve-out:
# a design doc is either executed (and the code is the record) or it belongs
# on the owner's machine, not in version control. The three specs that were
# tracked here moved to ~/.claude/plans/.
docs/superpowers/

# OS files
Thumbs.db

# Backup and export files
*.bak
*.dump
*.sql
